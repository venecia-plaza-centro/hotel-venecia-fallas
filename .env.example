# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.
#
# Sin estas dos variables la web funciona con datos de ejemplo
# (src/lib/fixtures.ts) y las reservas no se guardan: solo se registran por
# consola. Útil para desarrollar el flujo sin cuenta de Airtable.

# Personal Access Token de Airtable — https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=

# ID de la base (empieza por "app"). Sale en la URL de la base o en
# https://airtable.com/api
AIRTABLE_BASE_ID=

# Redsys (TPV virtual del banco). Sin REDSYS_MERCHANT_CODE + REDSYS_SECRET_KEY
# la web funciona en modo demostración: el pago se salta por completo y la
# reserva se crea directamente sin cobrar nada, para poder probar el flujo
# entero sin TPV.

# Código de comercio (FUC) que da el banco.
REDSYS_MERCHANT_CODE=

# Número de terminal (normalmente 1).
REDSYS_TERMINAL=1

# Clave secreta de firma SHA-256 (base64), del portal Canales de Redsys →
# Administración → Consulta de datos de comercio. Es un secreto: solo en
# variables de entorno de Vercel, nunca en el código.
REDSYS_SECRET_KEY=

# "test" (por defecto) = TPV de pruebas de Redsys; "live" = cobros reales.
REDSYS_ENV=test

# Emails de confirmación (Resend, resend.com). Sin RESEND_API_KEY no se envía
# nada: solo se registra por consola, para probar en local.
# Clave con permiso "Sending access" del dominio verificado.
RESEND_API_KEY=

# Remitente (debe ser de un dominio verificado en Resend).
EMAIL_FROM="Hotel Venecia Plaza Centro <fallas@hotelvenecia.com>"

# Interruptor de apertura de ventas (ver src/lib/sales.ts). Sin ninguna de
# estas dos variables las ventas están CERRADAS.
#   SALES_OPEN=true  → abiertas ya · SALES_OPEN=false → cerradas
#   SALES_OPEN_FROM  → apertura automática a esa hora (ISO, con zona horaria)
SALES_OPEN=
SALES_OPEN_FROM=
