# Copia este archivo a .env y rellena los valores. .env NUNCA se commitea.
#
# Sin estas dos variables la web funciona con datos de ejemplo
# (src/lib/fixtures.ts) y las reservas no se guardan: solo se registran por
# consola. Útil para desarrollar el flujo sin cuenta de Airtable.

# Personal Access Token de Airtable — https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=

# ID de la base (empieza por "app"). Sale en la URL de la base o en
# https://airtable.com/api
AIRTABLE_BASE_ID=

# Sin estas dos variables la web funciona en modo demostración: el pago se
# salta por completo y la reserva se crea directamente sin cobrar nada, para
# poder probar el flujo entero sin cuenta de Stripe.

# Clave secreta de Stripe (modo test: "sk_test_…", modo real: "sk_live_…") —
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Firma del webhook — la genera Stripe al crear el endpoint en
# https://dashboard.stripe.com/webhooks (evento a escuchar:
# checkout.session.completed), o "stripe listen" en local.
STRIPE_WEBHOOK_SECRET=
