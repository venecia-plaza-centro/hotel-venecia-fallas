---
// Balcón antiguo forjado, en el mismo estilo de línea dorada que los
// iconos de public/icons/*.png: dos pasamanos y barrotes, con una voluta
// central como las que se ven en los balcones reales del hotel.
interface Props { style?: string }
const { style } = Astro.props;
---

<svg class="gold-rule" style={style} viewBox="0 0 72 24" aria-hidden="true">
  <path d="M3 5H69M3 19H69M10 5V19M20 5V19M30 5V19M42 5V19M52 5V19M62 5V19" />
  <path class="gold-rule-scroll" d="M33 9c2-2.4 5-2.4 6 0 .8 2-1 4-3 4s-3.8-2-3-4Z" />
</svg>
