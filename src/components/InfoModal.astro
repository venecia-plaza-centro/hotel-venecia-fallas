---
/**
 * Ventana emergente (pop-up) con información: se abre al pulsar un botón con `data-info-open="<id>"`
 * (los de «Información» de las cabeceras de Balcones y Espacios) y se cierra con la X, con Esc o
 * pulsando fuera. Es un <dialog> nativo: accesible, con foco atrapado y sin librerías.
 */
interface Props { id: string; label: string; closeLabel: string; }
const { id, label, closeLabel } = Astro.props;
---

<dialog id={id} class="info-modal" aria-label={label}>
  <div class="info-modal-box">
    <button type="button" class="info-modal-close" data-info-close aria-label={closeLabel}>&times;</button>
    <div class="info-modal-body"><slot /></div>
  </div>
</dialog>

<script>
  import '../scripts/info-modal';
</script>

<style is:global>
  .info-modal {
    margin: auto; width: min(94vw, 960px); max-height: 88vh; max-height: 88dvh; padding: 0; border: 0; border-radius: 20px;
    background: #fff; color: var(--text-dark, #1a1a2e); box-shadow: 0 30px 80px rgba(8, 14, 30, .55); overflow: hidden;
  }
  .info-modal[open] { animation: infoModalIn .28s cubic-bezier(.16, 1, .3, 1); }
  .info-modal::backdrop { background: rgba(8, 14, 30, .68); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .info-modal-box { position: relative; max-height: inherit; }
  .info-modal-body { max-height: 88vh; max-height: 88dvh; overflow-y: auto; overscroll-behavior: contain; padding: 58px 30px 30px; }
  .info-modal-close {
    position: absolute; top: 10px; right: 12px; z-index: 2; width: 40px; height: 40px; border-radius: 50%;
    border: 1.5px solid var(--cream-dark); background: #fff; color: var(--navy); font-size: 26px; line-height: 1; cursor: pointer;
    display: grid; place-items: center; transition: background .2s, color .2s, border-color .2s;
  }
  .info-modal-close:hover { background: var(--navy); color: #fff; border-color: var(--navy); }
  @keyframes infoModalIn { from { opacity: 0; transform: translateY(14px) scale(.98); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .info-modal[open] { animation: none; } }
  @media (max-width: 600px) { .info-modal-body { padding: 52px 16px 22px; } }
</style>
