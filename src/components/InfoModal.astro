---
/**
 * Ventana emergente (pop-up) con información: se abre al pulsar un botón con `data-info-open="<id>"`
 * (los de «Información» de las cabeceras de Balcones y Espacios) y se cierra con la X, con Esc o
 * pulsando fuera. Con `auto` se abre sola al entrar en la página (ver info-modal.ts). Es un <dialog> nativo: accesible, con foco atrapado y sin librerías.
 */
interface Props { id: string; label: string; closeLabel: string; auto?: boolean; }
const { id, label, closeLabel, auto = false } = Astro.props;
---

<dialog id={id} class="info-modal" aria-label={label} data-auto={auto ? 'true' : undefined}>
  <div class="info-modal-box">
    <button type="button" class="info-modal-close" data-info-close aria-label={closeLabel}>&times;</button>
    <div class="info-modal-body">
      <img class="info-modal-logo" src="/img/logo-hotel-venecia.png" width="56" height="56" alt="" loading="lazy" decoding="async" />
      <slot />
    </div>
  </div>
</dialog>

<script>
  import '../scripts/info-modal';
</script>

<style is:global>
  .info-modal {
    margin: auto; width: min(94vw, 960px); max-height: 88vh; max-height: 88dvh; padding: 0; border: 0; border-radius: 20px;
    background: #fff; color: var(--text-dark, #1a1a2e); box-shadow: 0 30px 80px rgba(8, 14, 30, .55); overflow: hidden;
  }
  .info-modal[open] { animation: infoModalBeat .95s cubic-bezier(.3, .7, .3, 1) both; }
  .info-modal::backdrop { background: rgba(8, 14, 30, .68); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .info-modal-box { position: relative; max-height: inherit; }
  .info-modal-body { max-height: 88vh; max-height: 88dvh; overflow-y: auto; overscroll-behavior: contain; padding: 22px 30px 30px; }
  .info-modal .spaces-info { padding-top: 0; }
  .info-modal-logo { display: block; width: 54px; height: 54px; margin: 0 auto 18px; object-fit: contain; }
  .info-modal-close {
    position: absolute; top: 10px; right: 12px; z-index: 2; width: 40px; height: 40px; border-radius: 50%;
    border: 1.5px solid var(--cream-dark); background: #fff; color: var(--navy); font-size: 26px; line-height: 1; cursor: pointer;
    display: grid; place-items: center; transition: background .2s, color .2s, border-color .2s;
  }
  .info-modal-close:hover { background: var(--navy); color: #fff; border-color: var(--navy); }
  /* Efecto latido: aparece y da dos latidos seguidos («lub-dub») antes de quedarse quieta. */
  @keyframes infoModalBeat {
    0%   { opacity: 0; transform: scale(.82); }
    18%  { opacity: 1; transform: scale(1.06); }
    32%  { transform: scale(.975); }
    48%  { transform: scale(1.04); }
    64%  { transform: scale(.99); }
    80%  { transform: scale(1.012); }
    100% { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .info-modal[open] { animation: none; } }
  @media (max-width: 600px) { .info-modal-body { padding: 20px 16px 22px; } .info-modal-logo { width: 48px; height: 48px; } }
</style>
