---
import { type Locale } from '../../consts';
import { useT } from '../../i18n/ui';
import { pagePath } from '../../i18n/pages';
import PageHero from '../PageHero.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// La 12 ("¿Qué reservo exactamente?") va la primera: es la duda clave de un balcón que es una habitación.
// La 13 (los espacios) va justo después: es la otra cosa que se puede reservar.
const qa = [12, 13, ...Array.from({ length: 11 }, (_, i) => i + 1)].map((n) => ({ q: t(`faq.q${n}`), a: t(`faq.a${n}`) }));

// Las respuestas meten marcadores {cancellationLink} / {spacesLink} que aquí
// se convierten en un enlace real a esa página (mismo patrón que en Legal.astro).
const cancellationUrl = pagePath('cancellation', lang);
const spacesUrl = pagePath('spaces', lang);
const link = (href: string, label: string) => `<a href="${href}" style="color:var(--gold);text-decoration:underline">${label}</a>`;
const linkify = (text: string) =>
  text
    .replace('{cancellationLink}', link(cancellationUrl, t('legal.cancellation.h1')))
    .replace('{spacesLink}', link(spacesUrl, t('nav.spaces')));
---

<PageHero title={t('faq.h1')} />

<section class="section faq-section">
  <div class="container" style="max-width:720px">
    {qa.map((item) => (
      <div style="border-bottom:1px solid var(--cream-dark);padding:18px 0">
        <h2 style="font-family:var(--ff-display);font-size:18px;color:var(--navy)">
          {item.q}
        </h2>
        <p style="color:var(--text-mid);font-size:15px;margin-top:10px" set:html={linkify(item.a)} />
      </div>
    ))}
  </div>
</section>

<style>
  /* El texto arranca más cerca de la cabecera (el padding general de .section es 96px). */
  .faq-section { padding-top: 40px; text-align: center; }
</style>
