---
import { FALLAS, type Locale } from '../../consts';
import { useT } from '../../i18n/ui';
import { pagePath } from '../../i18n/pages';
import { getSpaces, spacePriceForDay } from '../../lib/spaces';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// Datos de los espacios: src/lib/spaces.ts (más adelante, Airtable).
const spaces = await getSpaces();

const LOCALE = { es: 'es-ES', en: 'en-GB', it: 'it-IT', fr: 'fr-FR', de: 'de-DE' }[lang];
// "useGrouping: always" para que 1300 salga "1.300 €" también en español.
const money = (n: number) =>
  new Intl.NumberFormat(LOCALE, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0, useGrouping: 'always' } as Intl.NumberFormatOptions).format(n);
const list = new Intl.ListFormat(LOCALE, { style: 'long', type: 'conjunction' });
const fill = (s: string, vars: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));
// "1 y 2 de marzo", "March 1, 2, 3 and 14", "1., 2., 3. und 14. März"…
const dayList = (days: number[]) =>
  fill(t('spaces.days.fmt'), { days: list.format(days.map((d) => (lang === 'de' ? `${d}.` : String(d)))) });

const bookUrl = pagePath('book', lang);
const contactUrl = pagePath('contact', lang);
const infoKeys = ['hours', 'rates', 'early', 'bath', 'use', 'decor'] as const;
// Iconos de línea (24×24) de cada tarjeta de condiciones; «whole» es la destacada.
const ICONS: Record<string, string> = {
  whole: '<path d="M3 21V9l9-6 9 6v12"/><path d="M9 21v-7h6v7"/>',
  hours: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  rates: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.2"/>',
  early: '<circle cx="8" cy="15" r="4"/><path d="m10.8 12.2 9.2-9.2M16 7l3 3M14 9l2 2"/>',
  bath: '<path d="M4 12h16v3a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M6 12V6a2 2 0 0 1 2-2h1"/><path d="M7 20l-1 2M17 20l1 2"/>',
  use: '<path d="M21 13.5A9 9 0 1 1 10.5 3a7 7 0 0 0 10.5 10.5z"/>',
  decor: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m21 16-5-5-9 9"/>',
};
const hoursVars = { start: FALLAS.accessStart, end: FALLAS.accessEnd };
---

<PageHero title={t('spaces.h1')} lead={t('spaces.lead')} photo="/images/espacios/506/foto-1600.webp" />

<section class="section spaces-info">
  <div class="container" style="max-width:1040px">
    <p class="spaces-intro">{t('spaces.intro')}</p>

    <h2>{t('spaces.info.h')}</h2>

    <!-- «Espacio exclusivo» destacado (lo más importante) y el resto en tarjetas con icono. -->
    <div class="info-feature">
      <span class="ic"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.whole} /></span>
      <div>
        <h3>{t('spaces.info.whole.l')}</h3>
        <p>{fill(t('spaces.info.whole.t'), hoursVars).replace(/^./, (c) => c.toUpperCase())}</p>
      </div>
    </div>
    <div class="info-grid">
      {infoKeys.map((k) => (
        <div class="info-card">
          <span class="ic"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[k]} /></span>
          <h3>{t(`spaces.info.${k}.l`)}</h3>
          <p>{fill(t(`spaces.info.${k}.t`), hoursVars).replace(/^./, (c) => c.toUpperCase())}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section spaces-glance">
  <div class="container" style="max-width:760px">
    <h2 class="h2" style="text-align:center;margin-bottom:22px">{t('spaces.glance.h')}</h2>
    <ul class="glance-list">
      {spaces.map((s) => (
        <li data-space={s.number} data-m2={s.m2}>
          <a href={`#espacio-${s.number}`}>
            <span class="glance-name"><strong>{fill(t('spaces.card.title'), { n: s.number })}</strong> · {t(`spaces.floor.${s.floor}`)}</span>
            <span class="glance-meta js-g-meta">{fill(t('spaces.card.size'), { n: s.m2 })} · {fill(t('spaces.glance.people'), { n: s.capacity })}</span>
            <span class="glance-price js-g-price">{money(s.price)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section spaces-cards">
  <div class="container">
    {spaces.map((s) => {
      const special = Object.entries(s.priceByDay ?? {}).map(([day, price]) => ({ day: Number(day), price }));
      return (
        <article class="space" id={`espacio-${s.number}`} data-space={s.number}>
          <div class="space-photo">
            <img
              src={`/images/espacios/${s.number}/foto-1600.webp`}
              srcset={`/images/espacios/${s.number}/foto-800.webp 800w, /images/espacios/${s.number}/foto-1600.webp 1600w`}
              sizes="(min-width: 960px) 560px, 92vw"
              width="1600"
              height="900"
              alt={fill(t('spaces.card.photo.alt'), { n: s.number })}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="space-body">
            <p class="space-floor">{t(`spaces.floor.${s.floor}`)}</p>
            <h3>{fill(t('spaces.card.title'), { n: s.number })}</h3>
            <ul class="space-facts">
              <li>{fill(t('spaces.card.size'), { n: s.m2 })}</li>
              <li class="js-cap">{fill(t('spaces.card.cap'), { n: s.capacity })}</li>
            </ul>
            <p class="space-desc">{t(`spaces.desc.${s.number}`)}</p>
            <p class="space-whole js-whole">{fill(t('spaces.card.whole'), { n: s.capacity })}</p>
            <p class="space-days js-days">{fill(t('spaces.card.days'), { days: dayList(s.days) })}</p>

            <div class="space-price">
              <strong class="js-price">{money(s.price)}</strong>
              <span>{t('spaces.card.perday')}</span>
              <div class="js-special">
                {special.map((p) => (
                  <em>{fill(t('spaces.card.special'), { date: dayList([p.day]), price: money(spacePriceForDay(s, p.day)) })}</em>
                ))}
              </div>
            </div>

            <a class="btn btn-gold btn-arrow" href={`${bookUrl}?espacio=${s.number}`}>
              {t('spaces.card.cta')} <span class="btn-ic"><Icon name="arrow-right" size={16} /></span>
            </a>
          </div>

          <div class="space-maps">
            <figure>
              <img src={`/images/espacios/${s.number}/plano.webp`} alt={fill(t('spaces.card.plan.alt'), { n: s.number })} loading="lazy" decoding="async" />
              <figcaption>{t('spaces.card.plan')}</figcaption>
            </figure>
            {s.hasFacade && (
              <figure>
                <img src={`/images/espacios/${s.number}/fachada.webp`} alt={fill(t('spaces.card.facade.alt'), { n: s.number })} loading="lazy" decoding="async" />
                <figcaption>{t('spaces.card.facade')}</figcaption>
              </figure>
            )}
          </div>

        </article>
      );
    })}
  </div>
</section>

<section class="section spaces-outro">
  <div class="container" style="max-width:640px">
    <p class="spaces-outro-main">{t('spaces.outro')}</p>
    <p class="spaces-outro-q">{t('spaces.outro.q')} <a href={contactUrl}>{t('spaces.outro.link')}</a></p>
  </div>
</section>

<!-- Textos y formato para que /api/spaces ponga al día precios, aforo y días
     (ver src/scripts/spaces-live.ts). -->
<script type="application/json" id="spaces-live-config" set:html={JSON.stringify({
  lang,
  locale: LOCALE,
  strings: Object.fromEntries(
    ['spaces.days.fmt', 'spaces.card.size', 'spaces.card.cap', 'spaces.card.whole', 'spaces.card.days', 'spaces.card.special', 'spaces.glance.people'].map((k) => [k, t(k)]),
  ),
})} />
<script>
  import '../../scripts/spaces-live';
</script>

<style>
  /* Misma línea que la página de Mascletàs: columna centrada, títulos en serif,
     rombos dorados en las listas y filas con línea fina. */
  .spaces-info { text-align: center; padding-bottom: 8px; }
  .spaces-intro { color: var(--text-mid); font-size: 17px; line-height: 1.75; max-width: 640px; margin: 0 auto; }
  .spaces-info h2 { font-size: clamp(22px, 3vw, 28px); margin: 44px 0 18px; }
  .spaces-info h2 { margin-bottom: 26px; }
  .info-feature {
    display: flex; align-items: center; gap: 24px; text-align: left; margin-bottom: 22px; padding: 28px 34px;
    background: linear-gradient(135deg, #1B2A4A, #243459); border: 1px solid rgba(201, 162, 70, .45);
    border-radius: 20px; box-shadow: 0 14px 34px rgba(27, 42, 74, .22); color: #fff;
  }
  .info-feature .ic {
    flex: none; width: 66px; height: 66px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(201, 162, 70, .16); border: 1px solid rgba(201, 162, 70, .55); color: var(--gold-light);
  }
  .info-feature h3 { margin: 0 0 6px; font-size: 24px; color: var(--gold-light); }
  .info-feature p { margin: 0; color: rgba(255, 255, 255, .9); font-size: 16px; line-height: 1.65; }
  .info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .info-card {
    display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 26px 22px 24px; text-align: center;
    background: #fff; border: 1px solid var(--cream-dark); border-radius: 18px; box-shadow: 0 4px 14px rgba(27, 42, 74, .06);
    transition: transform .25s, box-shadow .25s, border-color .25s;
  }
  .info-card:hover { transform: translateY(-3px); border-color: var(--gold); box-shadow: 0 12px 26px rgba(27, 42, 74, .12); }
  .info-card .ic { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: #F6EFD9; color: #B8923A; }
  .info-card h3 { margin: 2px 0 0; font-size: 19px; }
  .info-card p { margin: 0; color: var(--text-mid); font-size: 15px; line-height: 1.65; }
  @media (max-width: 900px) { .info-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .info-grid { grid-template-columns: 1fr; gap: 14px; }
    .info-feature { flex-direction: column; gap: 14px; padding: 26px 22px; text-align: center; }
  }

  .spaces-glance { padding-top: 48px; padding-bottom: 8px; }
  .glance-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .glance-list a {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: baseline; gap: 16px;
    padding: 12px 4px; border-bottom: 1px solid var(--cream-dark); color: inherit; text-decoration: none;
    transition: background .2s;
  }
  .glance-list a:hover { background: rgba(201, 162, 70, .08); }
  .glance-meta { color: var(--gold); font-style: italic; text-align: center; }
  .glance-price { color: var(--navy); font-weight: 700; text-align: right; }
  @media (max-width: 600px) {
    .glance-list a { grid-template-columns: 1fr auto; gap: 2px 12px; }
    .glance-meta { grid-column: 1 / -1; grid-row: 2; text-align: left; font-size: 14px; }
  }

  .spaces-cards { padding-top: 56px; }
  .space { display: grid; grid-template-columns: 1fr; gap: 26px; max-width: 1040px; margin: 0 auto 72px; scroll-margin-top: 96px; }
  .space-photo img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; box-shadow: var(--sh-md); }
  .space-body { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .space-body > * { margin-top: 0; margin-bottom: 0; }
  .space-floor { color: var(--gold); font-family: var(--ff-display); font-style: italic; font-size: 17px; }
  .space h3 { font-size: clamp(28px, 3.6vw, 36px); }
  .space-facts { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 10px; }
  .space-facts li { padding: 6px 16px; border-radius: 999px; background: #fff; border: 1px solid var(--gold-light); color: var(--navy); font-size: 14px; font-weight: 600; }
  .space-desc { max-width: 520px; color: var(--text-mid); font-size: 16px; line-height: 1.75; }
  .space-whole {
    max-width: 520px; padding: 10px 18px; border-radius: 10px;
    background: rgba(201, 162, 70, .12); color: var(--navy); font-size: 14px; font-weight: 600; line-height: 1.5;
  }
  .space-days { color: var(--text-soft); font-size: 15px; font-style: italic; }
  .space-price { display: flex; flex-direction: column; align-items: center; gap: 2px; margin-top: 4px; }
  .space-price strong { font-family: var(--ff-display); font-size: 36px; line-height: 1.1; color: var(--navy); }
  .space-price span { color: var(--text-soft); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .space-price em { display: block; margin-top: 4px; color: var(--gold); font-size: 15px; }
  .js-special { display: contents; }
  .space[hidden], .glance-list li[hidden] { display: none; }
  .space-maps { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-end; gap: 14px; margin: 6px 0 4px; }
  .space-maps figure { margin: 0; text-align: center; max-width: 100%; }
  .space-maps img { display: block; height: 190px; width: auto; max-width: 100%; object-fit: contain; padding: 6px; border-radius: 10px; background: #fff; border: 1px solid var(--cream-dark); }
  .space-maps figcaption { margin-top: 6px; color: var(--text-soft); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .space-body .btn { margin-top: 8px; }
  /* Móvil: foto, texto con precio y botón, y por último plano y fachada.
     Escritorio: foto + plano/fachada en una columna y el texto en la otra, para
     que las dos pesen parecido; alternan de lado. */
  @media (min-width: 960px) {
    .space {
      grid-template-columns: 1.15fr 1fr; gap: 28px 56px; align-items: start;
      grid-template-areas: 'photo body' 'maps body';
    }
    .space:nth-child(even) { grid-template-columns: 1fr 1.15fr; grid-template-areas: 'body photo' 'body maps'; }
    .space-photo { grid-area: photo; }
    .space-body { grid-area: body; align-self: center; }
    .space-maps { grid-area: maps; margin: 0; }
  }

  .spaces-outro { padding-top: 0; text-align: center; }
  .spaces-outro-main { font-family: var(--ff-display); font-style: italic; font-size: clamp(20px, 2.6vw, 26px); line-height: 1.5; color: var(--navy); }
  .spaces-outro-q { margin-top: 18px; color: var(--text-mid); font-size: 16px; }
  .spaces-outro-q a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
</style>
