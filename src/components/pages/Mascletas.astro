---
import { FALLAS, type Locale } from '../../consts';
import { useT } from '../../i18n/ui';
import { pagePath } from '../../i18n/pages';
import PageHero from '../PageHero.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// 1–19 marzo 2027.
const days = Array.from({ length: 19 }, (_, i) => i + 1);
const tips = [1, 2, 3, 4, 5].map((n) => t(`mascletas.tips.${n}`));
---

<PageHero title={t('mascletas.h1')} lead={t('mascletas.lead')} photo="/video/hero-mascleta-poster.webp">
  <p class="mascletas-seecal"><a href="#calendario">{t('mascletas.seecal')} ↓</a></p>
</PageHero>

<section class="section mascletas-info">
  <div class="container" style="max-width:760px">
    <div class="mascletas-what">
      <div class="mascletas-what-text">
        <h2>{t('mascletas.what.h')}</h2>
        <p>{t('mascletas.what.p')}</p>
      </div>
      <img src="/images/home/tradicion-mascleta-640.webp" width="640" height="358" alt={t('home.tradicion.photo.alt')} loading="lazy" decoding="async" />
    </div>

    <h2>{t('mascletas.tips.h')}</h2>
    <ul>
      {tips.map((tip) => <li>{tip}</li>)}
    </ul>

    <h2>{t('mascletas.hotel.h')}</h2>
    <p>{t('mascletas.hotel.p')}</p>
    <p class="mascletas-cta"><a class="btn btn-gold" href={pagePath('rooms', lang)}>{t('home.cta')}</a></p>
  </div>
</section>

<section class="section mascletas-cal" id="calendario">
  <div class="container" style="max-width:760px">
    <h2 class="h2" style="text-align:center;margin-bottom:10px">{t('mascletas.march')}</h2>
    <p class="mascletas-pyro">{t('mascletas.pyro')}</p>
    <ul class="mascletas-list" style="list-style:none;display:grid;grid-template-columns:1fr;gap:2px">
      {days.map((d) => (
        <li style="display:flex;justify-content:space-between;gap:16px;padding:12px 4px;border-bottom:1px solid var(--cream-dark)">
          <span><strong>{d}</strong> {t('mascletas.month')}</span>
          <span style="color:var(--text-soft)">{FALLAS.mascletaTime}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .mascletas-info { padding-bottom: 8px; }
  .mascletas-cal { padding-top: 40px; scroll-margin-top: 90px; }
  .mascletas-info h2 { font-size: clamp(22px, 3vw, 28px); margin: 44px 0 14px; }
  .mascletas-info p { color: var(--text-mid); font-size: 16px; line-height: 1.75; }
  .mascletas-info ul { margin: 0; padding-left: 22px; display: grid; gap: 10px; }
  .mascletas-info li { color: var(--text-mid); font-size: 16px; line-height: 1.65; }
  .mascletas-info li::marker { color: var(--gold); }
  .mascletas-cta { margin-top: 26px; text-align: center; }
  .mascletas-seecal { margin-top: 14px; }
  .mascletas-seecal a { color: var(--gold-light); font-size: 15px; text-decoration: underline; text-underline-offset: 3px; }
  .mascletas-seecal a:hover { color: #fff; }
  .mascletas-pyro { text-align: center; color: var(--text-soft); font-size: 15px; font-style: italic; max-width: 560px; margin: 0 auto 28px; }
  .mascletas-what { display: grid; grid-template-columns: 1fr 280px; gap: 32px; align-items: center; }
  .mascletas-what .mascletas-what-text h2 { margin-top: 0; }
  .mascletas-what img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; box-shadow: var(--sh-md); }
  @media (max-width: 760px) {
    .mascletas-what { grid-template-columns: 1fr; gap: 20px; }
    .mascletas-what img { order: -1; height: 160px; aspect-ratio: auto; }
  }
</style>
