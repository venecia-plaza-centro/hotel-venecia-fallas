---
import { type Locale } from '../../consts';
import { useT } from '../../i18n/ui';
import { getRooms } from '../../lib/airtable';
import PageHero from '../PageHero.astro';
import RoomCard from '../RoomCard.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// Se lee de Airtable en build. Sin credenciales, datos de ejemplo
// (src/lib/fixtures.ts). El hotel edita precios/fotos sin tocar código.
const rooms = await getRooms();
---

<PageHero eyebrow={t('rooms.eyebrow')} title={t('rooms.h1')} lead={t('rooms.lead')} />

<section class="section">
  <div class="container">
    <p class="rooms-intro">{t('rooms.intro')}</p>
    <div class="rooms-list">
      {rooms.map((r) => <RoomCard room={r} lang={lang} />)}
    </div>
  </div>
</section>

<style>
  .rooms-intro { max-width: 720px; margin: 0 auto 36px; text-align: center; color: var(--text-mid); font-size: 16px; line-height: 1.7; }
  .rooms-list { display: grid; gap: 28px; max-width: 980px; margin: 0 auto; }
</style>
