---
import { FALLAS, SITE, type Locale } from '../../consts';
import Icon from '../Icon.astro';
import { useT } from '../../i18n/ui';
import { getRooms } from '../../lib/airtable';
import PageHero from '../PageHero.astro';
import RoomCard from '../RoomCard.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// Se lee de Airtable en build. Sin credenciales, datos de ejemplo
// (src/lib/fixtures.ts). El hotel edita precios/fotos sin tocar código.
const rooms = await getRooms();

const fmt = (key: string, vars: Record<string, string | number> = {}) =>
  t(key).replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));
const maxCapacity = Math.max(...rooms.map((r) => r.capacity));

const capacityNoteHtml = t('rooms.capacity_note').replace(
  SITE.email,
  `<a href="mailto:${SITE.email}">${SITE.email}</a>`,
);
---

<PageHero title={t('rooms.h1')} photo="/images/rooms/410/balcon.webp" lead={capacityNoteHtml} leadStrong shine tall scrollLabel={t('home.discover')} scrollHref="#balcones-info" rule={false} bottom />

<section class="section" id="balcones-info">
  <div class="container">
    <!-- PRUEBA: lo que es igual en todos los balcones, una sola vez arriba (no repetido en cada ficha). -->
    <div class="rooms-incl">
      <ul>
        <li><Icon name="shower" size={20} /><span>{t('roomcard.bath')}</span></li>
        <li><Icon name="sparkle" size={20} /><span>{t('roomcard.balcony')}</span></li>
        <li><Icon name="clock" size={20} /><span>{fmt('roomcard.hours', { start: FALLAS.accessStart, end: FALLAS.accessEnd })}</span></li>
        <li><Icon name="gift" size={20} /><span>{t('roomcard.snack')}</span></li>
      </ul>
      <p>{t('roomcard.private')}</p>
    </div>
    <div class="rooms-list">
      {rooms.map((r) => <RoomCard room={r} lang={lang} />)}
    </div>
    <p class="rooms-outro">{t('rooms.outro')}</p>
  </div>
</section>

<script>
  import '../../scripts/room-cards';
</script>

<style>
  /* El cuadro y las fichas empiezan más arriba, pegados a la cabecera. */
  #balcones-info { padding-top: 28px; }
  .rooms-incl { max-width: 720px; margin: 0 auto 30px; padding: 18px 22px 16px; background: #fff; border: 1px solid var(--cream-dark); border-radius: 16px; box-shadow: var(--sh-sm); }
  .rooms-incl ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 24px; }
  .rooms-incl li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.45; color: var(--text-mid); }
  .rooms-incl li :global(svg) { flex: none; margin-top: 1px; color: var(--gold); }
  .rooms-incl p { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--cream-dark); text-align: center; font-size: 13.5px; font-weight: 600; color: var(--navy); }
  @media (max-width: 560px) { .rooms-incl ul { grid-template-columns: 1fr; } }

  /* Fichas más cortas: planta y capacidad (lo que cambia de una a otra); lo común ya está arriba. */
  .rooms-list :global(.room-card-facts li:nth-child(n+3)),
  .rooms-list :global(.room-card-private) { display: none; }
  .rooms-list :global(.room-card-body) { padding: 20px 22px 22px; }
  .rooms-list :global(.room-card-facts) { margin-top: 10px; gap: 6px; }
  /* Móvil: una fila por balcón (foto a la izquierda, datos a la derecha). */
  @media (max-width: 760px) {
    .rooms-list { gap: 14px; }
    .rooms-list :global(.room-card-grid) { grid-template-columns: 40% 1fr; align-items: stretch; }
    .rooms-list :global(.room-card-grid .room-card-media) { order: 1; aspect-ratio: auto; height: 100%; min-height: 170px; }
    .rooms-list :global(.room-card-grid .room-card-body) { order: 2; text-align: left; padding: 14px 14px 14px; justify-content: center; }
    .rooms-list :global(.room-card-grid .room-card-body h3) { text-align: left; font-size: 18px; line-height: 1.2; }
    .rooms-list :global(.room-card-grid .room-card-facts) { max-width: none; margin: 8px 0 0; grid-template-columns: 1fr; }
    .rooms-list :global(.room-card-grid .room-card-facts li) { font-size: 13px; }
    .rooms-list :global(.room-card-grid .room-card-footer) { margin-top: 10px; flex-direction: column; align-items: flex-start; gap: 8px; }
    .rooms-list :global(.room-card-grid .room-card-price) { justify-content: flex-start; font-size: 13px; }
    .rooms-list :global(.room-card-grid .room-card-price strong) { font-size: 22px; }
    .rooms-list :global(.room-card-grid .btn) { padding: 10px 10px; font-size: 11.5px; letter-spacing: .04em; width: 100%; justify-content: center; text-align: center; }
    .rooms-list :global(.room-card-grid .btn .btn-ic) { display: none; }
  }
  .rooms-outro { max-width: 680px; margin: 44px auto 0; text-align: center; color: var(--text-mid); font-size: 15px; line-height: 1.7; }
  .rooms-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin: 0 auto; }
  /* Tablet estrecha: en 3 columnas la ficha es tan angosta que "Reservar
     habitación N" no cabe en una línea; con 2 columnas sí. */
  @media (min-width: 761px) and (max-width: 999px) { .rooms-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .rooms-list { grid-template-columns: 1fr; } }
</style>
