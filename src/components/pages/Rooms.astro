---
import { type Locale } from '../../consts';
import { useT } from '../../i18n/ui';
import { getRooms } from '../../lib/airtable';
import PageHero from '../PageHero.astro';
import RoomCard from '../RoomCard.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// Se lee de Airtable en build. Sin credenciales, datos de ejemplo
// (src/lib/fixtures.ts). El hotel edita precios/fotos sin tocar código.
const rooms = await getRooms();
---

<PageHero title={t('rooms.h1')} lead={t('rooms.lead')} leadItalic>
  <p class="rooms-intro">{t('rooms.intro')}</p>
  <p class="rooms-intro rooms-intro-highlight">{t('rooms.intro.highlight')}</p>
</PageHero>

<section class="section">
  <div class="container">
    <div class="rooms-list">
      {rooms.map((r) => <RoomCard room={r} lang={lang} />)}
    </div>
  </div>
</section>

<style>
  .rooms-intro {
    max-width: 620px; margin: 16px auto 0; text-align: center;
    color: rgba(255, 255, 255, .72); font-size: 15.5px; line-height: 1.7;
  }
  .rooms-intro-highlight { color: #fff; font-weight: 700; font-style: italic; }
  .rooms-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin: 0 auto; }
  @media (max-width: 760px) { .rooms-list { grid-template-columns: 1fr; } }
</style>
