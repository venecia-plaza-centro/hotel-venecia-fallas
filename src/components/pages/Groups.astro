---
import { type Locale } from '../../consts';
import { pagePath } from '../../i18n/pages';
import { useT } from '../../i18n/ui';
import PageHero from '../PageHero.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

const steps = [
  { t: t('groups.step1.t'), d: t('groups.step1.d') },
  { t: t('groups.step2.t'), d: t('groups.step2.d') },
  { t: t('groups.step3.t'), d: t('groups.step3.d') },
];
---

<PageHero eyebrow={t('groups.eyebrow')} title={t('groups.h1')} lead={t('groups.lead')} />

<section class="section">
  <div class="container" style="max-width:760px">
    {steps.map((s) => (
      <div style="padding:22px 0;border-bottom:1px solid var(--cream-dark)">
        <h3 style="font-size:20px">{s.t}</h3>
        <p style="color:var(--text-mid);font-size:15px;margin-top:8px">{s.d}</p>
      </div>
    ))}
    <div style="text-align:center;margin-top:36px">
      <a class="btn btn-gold" href={pagePath('book', lang)}>{t('groups.cta')}</a>
    </div>
  </div>
</section>
