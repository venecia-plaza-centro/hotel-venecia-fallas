---
import fs from 'node:fs';
import path from 'node:path';
import { type Locale } from '../../consts';
import { useT } from '../../i18n/ui';
import PageHero from '../PageHero.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// Las fotos son los archivos de public/images/galeria/, ordenados por nombre
// (con prefijo numérico para elegir el orden). Cada foto tiene su miniatura
// (640×800) en la subcarpeta miniaturas/, con el mismo nombre: las tarjetas
// cargan la pequeña y el visor a pantalla completa, la grande. Se pensó para 3-5: se abren en
// abanico y "rebotan" al aparecer (efecto BounceCards).
const dir = path.join(process.cwd(), 'public', 'images', 'galeria');
const files = fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((f) => /\.(webp|jpe?g|png|avif)$/i.test(f)).sort()
  : [];
const fill = (s: string, n: number) => s.replace('{n}', String(n));
---

<PageHero title={t('gallery.h1')} />

<section class="section gallery-section">
  <div class="container">
    <div class="bounce" data-count={files.length}>
      {files.map((f, i) => (
        <button type="button" class={`bounce-card bounce-card-${i}`} data-index={i} aria-label={fill(t('gallery.open'), i + 1)}>
          <img src={`/images/galeria/miniaturas/${f}`} data-full={`/images/galeria/${f}`} width="640" height="800" alt={fill(t('gallery.alt'), i + 1)} decoding="async" draggable="false" />
        </button>
      ))}
    </div>
  </div>
</section>

<dialog class="lightbox" id="lightbox">
  <button type="button" class="lb-btn lb-close" aria-label={t('gallery.close')}>×</button>
  <button type="button" class="lb-btn lb-prev" aria-label={t('gallery.prev')}>‹</button>
  <img class="lb-img" alt="" />
  <button type="button" class="lb-btn lb-next" aria-label={t('gallery.next')}>›</button>
</dialog>

<style>
  .gallery-section { padding-top: 24px; overflow-x: clip; }

  /* --w: ancho de cada tarjeta; nunca más de lo que cabe en el móvil con el
     abanico abierto (el conjunto ocupa ~2,5 veces el ancho de una tarjeta). */
  .bounce {
    --w: min(300px, calc((100vw - 32px) / 2.6));
    position: relative; display: flex; justify-content: center; align-items: center;
    width: 100%; height: calc(var(--w) * 1.25 + 64px); margin: 24px auto 8px;
  }
  .bounce-card {
    position: absolute; width: var(--w); aspect-ratio: 4 / 5; padding: 0; cursor: zoom-in;
    border: 5px solid #fff; border-radius: 22px; overflow: hidden; background: var(--cream-dark);
    box-shadow: 0 6px 18px rgba(27, 42, 74, .22);
    will-change: transform;
  }
  .bounce-card:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
  .bounce-card img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .bounce-card-1 { z-index: 3; }
  .bounce-card-2 { z-index: 2; }
  .bounce-card-0 { z-index: 1; }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lightbox::backdrop { background: rgba(10, 16, 32, .92); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lb-img { max-width: 90vw; max-height: 88vh; object-fit: contain; border-radius: 6px; }
  .lb-btn { position: absolute; background: rgba(255,255,255,.12); color: #fff; border: 0; border-radius: 50%; width: 46px; height: 46px; font-size: 28px; line-height: 1; cursor: pointer; }
  .lb-btn:hover { background: var(--gold); }
  .lb-close { top: 18px; right: 18px; }
  .lb-prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 18px; top: 50%; transform: translateY(-50%); }
</style>

<script>
  import { gsap } from 'gsap';

  const wrap = document.querySelector<HTMLElement>('.bounce');
  const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.bounce-card'));

  if (wrap && cards.length) {
    // Posición de cada tarjeta en el abanico: rotación y desplazamiento
    // horizontal en proporción a su ancho, para que se vea igual en cualquier
    // pantalla. La del centro va casi recta; las de los lados, abiertas.
    const ROT = [-8, 3, 9, -5, 6]; // grados (para hasta 5 tarjetas)
    const STEP = 0.74; // separación entre tarjetas, en anchos de tarjeta
    const PUSH = 0.3; // cuánto se apartan las vecinas al pasar el cursor
    const n = cards.length;
    const mid = (n - 1) / 2;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = matchMedia('(hover: hover)').matches;

    const width = () => cards[0].offsetWidth || 240;
    const rot = (i: number) => (n === 3 ? ROT[i] : ROT[i % ROT.length]);
    const baseX = (i: number) => (i - mid) * STEP * width();
    const base = (i: number) => `rotate(${rot(i)}deg) translate(${baseX(i)}px)`;
    const straight = (i: number) => `rotate(0deg) translate(${baseX(i)}px)`;
    const pushed = (i: number, hovered: number) =>
      `rotate(${rot(i)}deg) translate(${baseX(i) + (i < hovered ? -1 : 1) * PUSH * width()}px)`;

    const place = () => cards.forEach((c, i) => { c.style.transform = base(i); });
    place();

    // Aparecen con rebote elástico (salvo con "reducir movimiento").
    if (!reduced) {
      gsap.fromTo(
        cards,
        { scale: 0 },
        { scale: 1, stagger: 0.06, ease: 'elastic.out(1, 0.8)', delay: 0.4 },
      );
    }

    const to = (el: HTMLElement, transform: string, delay = 0) =>
      gsap.to(el, { transform, duration: reduced ? 0 : 0.4, ease: 'back.out(1.4)', delay, overwrite: 'auto' });

    const push = (hovered: number) => {
      cards.forEach((c, i) => {
        gsap.killTweensOf(c);
        if (i === hovered) to(c, straight(i));
        else to(c, pushed(i, hovered), Math.abs(hovered - i) * 0.05);
      });
    };
    const reset = () => cards.forEach((c, i) => { gsap.killTweensOf(c); to(c, base(i)); });

    cards.forEach((c, i) => {
      if (canHover) {
        c.addEventListener('mouseenter', () => push(i));
        c.addEventListener('mouseleave', reset);
      }
      c.addEventListener('focus', () => push(i));
      c.addEventListener('blur', reset);
    });

    // Si cambia el ancho de la pantalla, se recolocan.
    let lastW = width();
    new ResizeObserver(() => {
      if (Math.abs(width() - lastW) > 1) { lastW = width(); place(); }
    }).observe(wrap);

    // Visor a pantalla completa al pulsar una foto.
    const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (dlg) {
      const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
      const photos = cards.map((c) => c.querySelector('img')!);
      let cur = 0;
      const show = (i: number) => {
        cur = (i + photos.length) % photos.length;
        img.src = photos[cur].dataset.full || photos[cur].src;
        img.alt = photos[cur].alt;
      };
      cards.forEach((c, i) => c.addEventListener('click', () => { show(i); dlg.showModal(); }));
      dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
      dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
      dlg.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(cur - 1);
        if (e.key === 'ArrowRight') show(cur + 1);
      });
    }
  }
</script>
