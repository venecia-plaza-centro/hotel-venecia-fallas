---
import fs from 'node:fs';
import path from 'node:path';
import { type Locale } from '../../consts';
import { useT } from '../../i18n/ui';
import PageHero from '../PageHero.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// Las fotos son los archivos de public/images/galeria/, ordenados por nombre
// (con prefijo numérico para elegir el orden). Cada foto tiene su miniatura
// (640×800) en la subcarpeta miniaturas/, con el mismo nombre: los paneles
// del acordeón cargan la pequeña y el visor a pantalla completa, la grande.
const dir = path.join(process.cwd(), 'public', 'images', 'galeria');
const files = fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((f) => /\.(webp|jpe?g|png|avif)$/i.test(f)).sort()
  : [];
const fill = (s: string, n: number) => s.replace('{n}', String(n));
// Empieza abierta una foto del centro, ni la primera ni la última.
const initial = Math.floor((files.length - 1) / 2);
---

<PageHero title={t('gallery.h1')} />

<section class="section gallery-section">
  <div class="container">
    <div class="accordion" id="gallery-accordion">
      {files.map((f, i) => (
        <button
          type="button"
          class={`ag-panel${i === initial ? ' is-active' : ''}`}
          data-index={i}
          aria-label={fill(t('gallery.open'), i + 1)}
        >
          <img src={`/images/galeria/miniaturas/${f}`} data-full={`/images/galeria/${f}`} width="640" height="800" alt={fill(t('gallery.alt'), i + 1)} decoding="async" draggable="false" />
        </button>
      ))}
    </div>
  </div>
</section>

<dialog class="lightbox" id="lightbox">
  <button type="button" class="lb-btn lb-close" aria-label={t('gallery.close')}>×</button>
  <button type="button" class="lb-btn lb-prev" aria-label={t('gallery.prev')}>‹</button>
  <img class="lb-img" alt="" />
  <button type="button" class="lb-btn lb-next" aria-label={t('gallery.next')}>›</button>
</dialog>

<style>
  .gallery-section { padding-top: 24px; }

  .accordion { display: flex; gap: 8px; width: 100%; height: 460px; }
  .ag-panel {
    position: relative; flex: 1 1 0; min-width: 0; padding: 0; margin: 0; border: 0;
    overflow: hidden; border-radius: var(--r-lg); cursor: pointer; background: var(--navy);
    box-shadow: 0 10px 26px -16px rgba(27, 42, 74, .55);
    transition: flex-grow .55s cubic-bezier(.16, 1, .3, 1);
  }
  .ag-panel:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--gold), 0 10px 26px -16px rgba(27, 42, 74, .55); }
  .ag-panel img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none;
    filter: grayscale(1); transition: filter .55s cubic-bezier(.16, 1, .3, 1);
  }
  .ag-panel.is-active img { filter: grayscale(0); }
  .ag-panel::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, transparent 45%, rgba(8, 14, 28, .8) 100%);
    opacity: .5; transition: opacity .4s;
  }
  .ag-panel.is-active::after { opacity: .8; }

  @media (max-width: 640px) {
    .accordion { flex-direction: column; height: auto; gap: 10px; }
    .ag-panel { flex: none; height: 76px; }
    .ag-panel.is-active { height: 320px; }
    .ag-panel img { filter: grayscale(0); }
  }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lightbox::backdrop { background: rgba(10, 16, 32, .92); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lb-img { max-width: 90vw; max-height: 88vh; object-fit: contain; border-radius: 6px; }
  .lb-btn { position: absolute; background: rgba(255,255,255,.12); color: #fff; border: 0; border-radius: 50%; width: 46px; height: 46px; font-size: 28px; line-height: 1; cursor: pointer; }
  .lb-btn:hover { background: var(--gold); }
  .lb-close { top: 18px; right: 18px; }
  .lb-prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 18px; top: 50%; transform: translateY(-50%); }
</style>

<script>
  const acc = document.getElementById('gallery-accordion');
  const panels = Array.from(document.querySelectorAll<HTMLButtonElement>('.ag-panel'));

  if (acc && panels.length) {
    const canHover = matchMedia('(hover: hover)').matches;
    let active = panels.findIndex((p) => p.classList.contains('is-active'));
    if (active < 0) active = 0;

    const setActive = (i: number) => {
      active = i;
      panels.forEach((p, j) => {
        const isActive = j === i;
        p.classList.toggle('is-active', isActive);
        p.style.flexGrow = isActive ? '4' : '1';
        p.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };
    setActive(active);

    panels.forEach((p, i) => {
      if (canHover) p.addEventListener('mouseenter', () => setActive(i));
      p.addEventListener('focus', () => setActive(i));
      p.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          panels[(i + 1) % panels.length].focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          panels[(i - 1 + panels.length) % panels.length].focus();
        }
      });
    });

    // Visor a pantalla completa al pulsar una foto.
    const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (dlg) {
      const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
      const photos = panels.map((p) => p.querySelector('img')!);
      let cur = 0;
      const show = (i: number) => {
        cur = (i + photos.length) % photos.length;
        img.src = photos[cur].dataset.full || photos[cur].src;
        img.alt = photos[cur].alt;
      };
      panels.forEach((p, i) => p.addEventListener('click', () => { setActive(i); show(i); dlg.showModal(); }));
      dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
      dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
      dlg.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(cur - 1);
        if (e.key === 'ArrowRight') show(cur + 1);
      });
    }
  }
</script>
