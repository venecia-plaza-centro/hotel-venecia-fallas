---
import fs from 'node:fs';
import path from 'node:path';
import { type Locale } from '../../consts';
import { useT } from '../../i18n/ui';
import PageHero from '../PageHero.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// Las fotos son los archivos de public/images/galeria/, ordenados por nombre
// (con prefijo numérico para elegir el orden), con su forma natural (no se
// recortan a una proporción fija). Cada foto tiene su miniatura en la
// subcarpeta miniaturas/, con el mismo nombre: el carrusel carga la pequeña
// y el visor a pantalla completa, la grande.
const dir = path.join(process.cwd(), 'public', 'images', 'galeria');
const files = fs.existsSync(dir)
  ? fs.readdirSync(dir).filter((f) => /\.(webp|jpe?g|png|avif)$/i.test(f)).sort()
  : [];
// Se repite la lista para que el desfile sea continuo: en cuanto la primera
// tanda sale por la izquierda, la segunda ya ocupa su sitio, sin corte.
const track = files.length ? [...files, ...files] : [];
const fill = (s: string, n: number) => s.replace('{n}', String(n));
---

<PageHero title={t('gallery.h1')} photo="/images/fachada-hotel.webp" />

<section class="section gallery-section">
  <div class="marquee">
    <div class="track" style={`--n:${files.length}`}>
      {track.map((f, i) => (
        <button
          type="button"
          class="carousel-item"
          data-index={i % files.length}
          aria-label={fill(t('gallery.open'), (i % files.length) + 1)}
          tabindex={i < files.length ? 0 : -1}
          aria-hidden={i < files.length ? undefined : 'true'}
        >
          <img src={`/images/galeria/miniaturas/${f}`} data-full={`/images/galeria/${f}`} alt={fill(t('gallery.alt'), (i % files.length) + 1)} loading={i < files.length ? 'eager' : 'lazy'} decoding="async" draggable="false" />
        </button>
      ))}
    </div>
  </div>
</section>

<dialog class="lightbox" id="lightbox">
  <button type="button" class="lb-btn lb-close" aria-label={t('gallery.close')}>×</button>
  <button type="button" class="lb-btn lb-prev" aria-label={t('gallery.prev')}>‹</button>
  <img class="lb-img" alt="" />
  <button type="button" class="lb-btn lb-next" aria-label={t('gallery.next')}>›</button>
</dialog>

<style>
  .gallery-section { padding-top: 8px; padding-bottom: 8px; }

  .marquee { position: relative; overflow: hidden; width: 100%; padding-block: 8px; }
  .marquee::before, .marquee::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: clamp(24px, 6vw, 90px); z-index: 2; pointer-events: none;
  }
  .marquee::before { left: 0; background: linear-gradient(90deg, var(--cream), transparent); }
  .marquee::after { right: 0; background: linear-gradient(270deg, var(--cream), transparent); }

  .track {
    display: flex; align-items: center; gap: 16px; width: max-content;
    animation: gallery-scroll 32s linear infinite;
  }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes gallery-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% / 2)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }

  .carousel-item {
    flex: none; padding: 0; margin: 0; border: 0; border-radius: var(--r-lg); overflow: hidden;
    cursor: zoom-in; background: var(--cream-dark); box-shadow: 0 10px 24px -14px rgba(27, 42, 74, .5);
  }
  .carousel-item img { display: block; height: 320px; width: auto; max-width: none; transition: transform .4s var(--ease); }
  .carousel-item:hover img { transform: scale(1.03); }
  @media (max-width: 760px) { .carousel-item img { height: 240px; } }
  @media (max-width: 480px) { .carousel-item img { height: 190px; } }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; touch-action: pan-y; }
  .lightbox::backdrop { background: rgba(10, 16, 32, .92); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lb-img { max-width: 90vw; max-height: 88vh; object-fit: contain; border-radius: 6px; user-select: none; -webkit-user-drag: none; }
  .lb-btn { position: absolute; background: rgba(255,255,255,.12); color: #fff; border: 0; border-radius: 50%; width: 46px; height: 46px; font-size: 28px; line-height: 1; cursor: pointer; }
  .lb-btn:hover { background: var(--gold); }
  .lb-close { top: 18px; right: 18px; }
  /* Las flechas solo en dispositivos con puntero preciso (ratón): en
     móvil/tablet se pasa la foto ampliada deslizando el dedo. */
  .lb-prev, .lb-next { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .lb-prev, .lb-next { display: flex; align-items: center; justify-content: center; }
  }
  .lb-prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 18px; top: 50%; transform: translateY(-50%); }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-item'));
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;

  if (items.length && dlg) {
    const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
    // Una entrada por foto real (sin las duplicadas del bucle), en orden,
    // para que "siguiente/anterior" en el visor avance por fotos distintas.
    const n = Number(document.querySelector<HTMLElement>('.track')?.style.getPropertyValue('--n')) || items.length;
    const photos = items.slice(0, n).map((el) => el.querySelector('img')!);
    let cur = 0;
    const show = (i: number) => {
      cur = (i + photos.length) % photos.length;
      img.src = photos[cur].dataset.full || photos[cur].src;
      img.alt = photos[cur].alt;
    };
    items.forEach((el) => {
      const i = Number(el.dataset.index);
      el.addEventListener('click', () => { show(i); dlg.showModal(); });
    });
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });

    // Deslizar con el dedo (móvil/tablet) para pasar de foto ampliada.
    let touchX = 0;
    dlg.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>
