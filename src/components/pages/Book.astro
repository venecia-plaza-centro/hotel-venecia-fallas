---
import { FALLAS, type Locale } from '../../consts';
import { pagePath } from '../../i18n/pages';
import { dictFor, useT } from '../../i18n/ui';
import { FIRST_DAY, LAST_DAY } from '../../lib/booking';
import PageHero from '../PageHero.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

// Todas las cadenas book.* resueltas para este idioma → al cliente como JSON.
const strings = Object.fromEntries(
  Object.entries(dictFor(lang)).filter(([k]) => k.startsWith('book.') || k.startsWith('roomcard.')),
);

const config = {
  locale: lang,
  firstDay: FIRST_DAY,
  lastDay: LAST_DAY,
  accessStart: FALLAS.accessStart,
  accessEnd: FALLAS.accessEnd,
  mascletaTime: FALLAS.mascletaTime,
  urls: {
    terms: pagePath('terms', lang),
    privacy: pagePath('privacy', lang),
    home: pagePath('home', lang),
  },
};

const stepKeys = ['date', 'room', 'details', 'done'] as const;
---

<PageHero title={t('book.h1')} lead={t('book.lead')} />

<section class="section">
  <div class="container book">
    <ol class="book-steps" aria-label="Progreso">
      {stepKeys.map((s, i) => (
        <li data-stepper={s} aria-current={s === 'date' ? 'step' : undefined}>
          <span class="n">{i + 1}</span>
          <span class="l">{t(`book.step.${s}`)}</span>
        </li>
      ))}
    </ol>

    <div class="book-grid no-summary">
      <div class="book-main">
        <!-- Paso 1 · Fecha -->
        <div data-step="date" class="panel">
          <h2 tabindex="-1">{t('book.date.title')}</h2>
          <p class="hint">
            {t('book.date.window')
              .replace('{start}', config.accessStart)
              .replace('{end}', config.accessEnd)
              .replace('{mascleta}', config.mascletaTime)}
          </p>
          <div class="fields">
            <label>
              {t('book.date.guests')}
              <select id="f-guests" required>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
              </select>
            </label>
          </div>
          <p class="hint">{t('book.date.guestsHint')}</p>

          <span class="cal-label">{t('book.date.date')}</span>
          <div id="calendar" class="calendar">
            <div class="cal-grid" id="cal-grid"></div>
          </div>
          <p class="cal-legend">
            <span><i class="dot dot-free"></i>{t('book.date.legend.available')}</span>
            <span><i class="dot dot-full"></i>{t('book.date.legend.full')}</span>
          </p>
          <input type="hidden" id="f-date" />
          <p class="err" data-err="date" role="alert"></p>
          <div class="actions">
            <button type="button" class="btn btn-gold" id="date-submit">{t('book.date.submit')}</button>
          </div>
        </div>

        <!-- Paso 2 · Habitación -->
        <div data-step="room" class="panel" hidden>
          <h2 tabindex="-1">{t('book.room.title')}</h2>
          <div id="room-list" class="cards"></div>
          <div id="room-selected" class="room-selected" hidden></div>
          <p class="err" data-err="room" role="alert"></p>
        </div>

        <!-- Paso 3 · Datos -->
        <div data-step="details" class="panel" hidden>
          <h2 tabindex="-1">{t('book.details.title')}</h2>
          <form id="details-form" novalidate>
            <div class="fields">
              <label>
                {t('book.details.first')}
                <input type="text" name="firstName" autocomplete="given-name" required />
              </label>
              <label>
                {t('book.details.last')}
                <input type="text" name="lastName" autocomplete="family-name" required />
              </label>
              <label>
                {t('book.details.email')}
                <input type="email" name="email" autocomplete="email" required />
              </label>
              <label>
                {t('book.details.phone')}
                <input type="tel" name="phone" autocomplete="tel" required />
              </label>
              <label>
                {t('book.details.country')}
                <input type="text" name="country" autocomplete="country-name" />
              </label>
            </div>
            <label class="full">
              {t('book.details.notes')}
              <textarea name="notes" rows="3"></textarea>
            </label>
            <label class="check">
              <input type="checkbox" name="consent" />
              <span set:html={t('book.details.consent')
                .replace('{terms}', `<a href="${config.urls.terms}" target="_blank" rel="noopener">${t('book.details.consent.terms')}</a>`)
                .replace('{privacy}', `<a href="${config.urls.privacy}" target="_blank" rel="noopener">${t('book.details.consent.privacy')}</a>`)} />
            </label>
            <p class="err" data-err="details" role="alert"></p>
            <div class="actions">
              <button type="button" class="btn btn-ghost" data-nav="room">{t('book.details.back')}</button>
              <button type="submit" class="btn btn-gold" id="details-submit">{t('book.details.submit')}</button>
            </div>
          </form>
        </div>

        <!-- Paso 4 · Hecho -->
        <div data-step="done" class="panel" hidden>
          <div class="done-card">
            <svg class="done-check" viewBox="0 0 48 48" aria-hidden="true">
              <circle cx="24" cy="24" r="22" />
              <path d="M14 24.5l6.5 6.5L34 17" />
            </svg>
            <h2 tabindex="-1" id="done-title"></h2>
            <p class="done-lead" id="done-body"></p>
            <div class="done-locator">
              <span>{t('book.done.locator')}</span>
              <strong id="done-locator"></strong>
            </div>
            <div class="done-summary" id="done-summary"></div>
          </div>
          <p class="err" id="done-demo-payment" hidden>{t('book.done.demo.payment')}</p>
          <p class="err" id="done-demo" hidden>{t('book.done.demo')}</p>
          <div class="actions">
            <a class="btn btn-gold" href={config.urls.home}>{t('book.done.home')}</a>
          </div>
        </div>
      </div>

      <!-- Oculto en el paso Fecha (nada que resumir aún); show() lo
           muestra a partir de Habitación. -->
      <aside class="book-summary" aria-live="polite" hidden>
        <div class="book-summary-inner">
          <h2>{t('book.summary.title')}</h2>
          <div id="summary-body"><p class="hint">{t('book.summary.empty')}</p></div>
          <p class="hint pending">{t('book.summary.pending')}</p>
        </div>
      </aside>

      <!-- Botones del paso Habitación: debajo del resumen a propósito (ver
           el resumen antes de decidir cambiar los datos o continuar). -->
      <div data-step="room" class="actions" hidden>
        <button type="button" class="btn btn-ghost" data-nav="date">{t('book.room.back')}</button>
        <button type="button" class="btn btn-gold" id="room-next" disabled>{t('book.room.next')}</button>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="book-config" set:html={JSON.stringify(config)}></script>
<script type="application/json" id="book-i18n" set:html={JSON.stringify(strings)}></script>

<script>
  // Astro empaqueta este script junto al de otros componentes (Nav, RoomCard...)
  // en un único archivo compartido por todas las páginas; sin esta guarda, en
  // cualquier página que no sea "Reservar" fallaría al no existir #book-config,
  // y ese error interrumpiría también la ejecución del resto del archivo
  // (menú hamburguesa, slider de fotos...) en todas las demás páginas.
  if (document.getElementById('book-config')) {
  const cfg = JSON.parse(document.getElementById('book-config').textContent);
  const T = JSON.parse(document.getElementById('book-i18n').textContent);

  const fmt = (key, vars = {}) =>
    (T[key] || key).replace(/\{(\w+)\}/g, (_, k) => (k in vars ? vars[k] : ''));
  const money = (n) =>
    new Intl.NumberFormat(cfg.locale, {
      style: 'currency',
      currency: 'EUR',
      maximumFractionDigits: 0,
    }).format(n);
  const fdate = (d) =>
    new Intl.DateTimeFormat(cfg.locale, { weekday: 'short', day: 'numeric', month: 'long' }).format(
      new Date(d + 'T00:00:00'),
    );
  const $ = (sel, root = document) => root.querySelector(sel);

  // Viene de "Reservar habitación X" (Home/Habitaciones): esa habitación ya
  // la quería el cliente, así que en cuanto elija fecha se comprueba
  // disponibilidad al momento (sin el clic extra de "Buscar disponibilidad")
  // y, si sigue libre, queda preseleccionada en el paso siguiente.
  const params = new URLSearchParams(location.search);
  const prefRoom = params.get('room');

  const state = {
    date: '', guests: 2,
    rooms: [],
    roomSlug: '',
    locator: '', persisted: true, paid: false, quote: null, email: '', phone: '', confirmVia: 'email',
  };

  // Un paso puede tener más de un elemento con el mismo data-step: el
  // panel principal y, en "room", también sus botones (ver el comentario
  // junto al <div data-step="room" class="actions"> en el HTML, movidos
  // fuera de .book-main a propósito). Por eso panels[paso] es un array.
  const panels = {};
  document.querySelectorAll('[data-step]').forEach((p) => {
    (panels[p.dataset.step] ??= []).push(p);
  });
  const steppers = {};
  document.querySelectorAll('[data-stepper]').forEach((s) => (steppers[s.dataset.stepper] = s));

  const STEPS = ['date', 'room', 'details', 'done'];
  const order = (s) => STEPS.indexOf(s);

  // En el paso Fecha el resumen no aporta nada todavía (ni fecha ni
  // habitación elegidas): se oculta ahí y aparece a partir de Habitación,
  // ya con datos reales que enseñar.
  const summaryAside = document.querySelector('.book-summary');

  function show(step) {
    Object.entries(panels).forEach(([k, els]) => els.forEach((p) => (p.hidden = k !== step)));
    Object.entries(steppers).forEach(([k, s]) => {
      s.classList.toggle('is-done', order(k) < order(step));
      s.classList.toggle('is-active', k === step);
      if (k === step) s.setAttribute('aria-current', 'step');
      else s.removeAttribute('aria-current');
    });
    if (summaryAside) summaryAside.hidden = step === 'date';
    // Sin el resumen, la columna de 300px que le reservaba sitio dejaba un
    // hueco vacío a la derecha en escritorio: se quita esa columna mientras
    // el resumen esté oculto.
    document.querySelector('.book-grid')?.classList.toggle('no-summary', step === 'date');
    const mainPanel = panels[step][0];
    const h = $('h2', mainPanel);
    if (h) h.focus();
    mainPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function setErr(step, msg) {
    const el = document.querySelector(`[data-err="${step}"]`);
    if (el) el.textContent = msg || '';
  }
  function loading(btn, on, label) {
    btn.disabled = on;
    btn.dataset.label ??= btn.textContent;
    btn.textContent = on ? label || btn.dataset.label : btn.dataset.label;
  }

  // ---- Paso fecha ---------------------------------------------------------
  const dateEl = $('#f-date');
  const guestsEl = $('#f-guests');

  // Todas las fechas de la ventana de venta, para pintar el calendario.
  // Todo en UTC (fecha ISO, día de la semana, día del mes): si se mezclara
  // con horas locales, en un huso adelantado a UTC (p.ej. Europa) el primer
  // día se calcularía mal por culpa del cambio de zona horaria.
  const SALE_DAYS = [];
  {
    const d = new Date(`${cfg.firstDay}T00:00:00Z`);
    const last = new Date(`${cfg.lastDay}T00:00:00Z`);
    while (d <= last) {
      SALE_DAYS.push(d.toISOString().slice(0, 10));
      d.setUTCDate(d.getUTCDate() + 1);
    }
  }
  const weekdayFmt = new Intl.DateTimeFormat(cfg.locale, { weekday: 'short', timeZone: 'UTC' });
  const availability = {}; // fecha ISO → nº de habitaciones libres (undefined = aún no se sabe)

  function renderCalendar() {
    const grid = $('#cal-grid');
    grid.innerHTML = '';
    const firstDate = new Date(`${cfg.firstDay}T00:00:00Z`);
    const startDow = (firstDate.getUTCDay() + 6) % 7; // lunes = 0

    for (let i = 0; i < 7; i++) {
      const ref = new Date(firstDate);
      ref.setUTCDate(firstDate.getUTCDate() - startDow + i);
      const h = document.createElement('div');
      h.className = 'cal-dow';
      h.textContent = weekdayFmt.format(ref);
      grid.appendChild(h);
    }
    for (let i = 0; i < startDow; i++) {
      const blank = document.createElement('div');
      blank.className = 'cal-day is-empty';
      grid.appendChild(blank);
    }
    for (const iso of SALE_DAYS) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cal-day';
      btn.textContent = String(new Date(`${iso}T00:00:00Z`).getUTCDate());
      const count = availability[iso];
      if (count === 0) {
        btn.classList.add('is-full');
        btn.disabled = true;
        btn.title = T['book.date.sold_out'];
      } else if (count > 0) {
        btn.classList.add('is-free');
      } else {
        btn.classList.add('is-pending');
      }
      if (iso === state.date) btn.classList.add('is-selected');
      btn.addEventListener('click', () => {
        state.date = iso;
        dateEl.value = iso;
        setErr('date', '');
        renderCalendar();
        if (prefRoom) runAvailability();
      });
      grid.appendChild(btn);
    }
    const trailing = (7 - ((startDow + SALE_DAYS.length) % 7)) % 7;
    for (let i = 0; i < trailing; i++) {
      const blank = document.createElement('div');
      blank.className = 'cal-day is-empty';
      grid.appendChild(blank);
    }
  }
  renderCalendar();

  fetch('/api/availability-summary')
    .then((res) => res.json())
    .then((data) => {
      if (!data.ok) return;
      for (const d of data.days) availability[d.date] = d.available;
      renderCalendar();
    })
    .catch(() => {
      // Sin resumen previo, el cliente puede igualmente elegir un día y
      // comprobar disponibilidad al pulsar "Buscar disponibilidad".
    });

  $('#date-submit').addEventListener('click', runAvailability);

  async function runAvailability() {
    setErr('date', '');
    const date = dateEl.value;
    const g = parseInt(guestsEl.value, 10) || 2;
    if (!date) return setErr('date', T['book.date.err.generic']);
    if (date < cfg.firstDay || date > cfg.lastDay) return setErr('date', T['book.date.err.range']);

    const btn = $('#date-submit');
    loading(btn, true);
    try {
      const res = await fetch(`/api/availability?date=${date}&guests=${g}`);
      const data = await res.json();
      if (!data.ok) return setErr('date', mapError(data));
      state.date = date;
      state.guests = g;
      state.rooms = data.rooms;
      const wanted = prefRoom && data.rooms.find((r) => r.slug === prefRoom);
      state.roomSlug = wanted && wanted.available && wanted.capacity >= g ? prefRoom : '';
      renderRooms();
      renderSummary();
      show('room');
    } catch {
      setErr('date', T['book.err.service']);
    } finally {
      loading(btn, false);
    }
  }

  function mapError(data) {
    if (data.error === 'fecha') {
      return data.detail === 'fuera-de-ventana' ? T['book.date.err.range'] : T['book.date.err.generic'];
    }
    if (data.error === 'servicio') return T['book.err.service'];
    if (data.error === 'sin-disponibilidad') return T['book.err.availability'];
    return T['book.err.generic'];
  }

  // ---- Paso habitación ---------------------------------------------------
  // Mismos iconos de línea que Icon.astro (24×24, stroke=currentColor), para
  // poder pintar la tarjeta .room-card desde JS sin depender del componente.
  const ROOM_ICONS = {
    pin: '<path d="M12 21s-7-6.3-7-11a7 7 0 1 1 14 0c0 4.7-7 11-7 11Z"/><circle cx="12" cy="10" r="2.4"/>',
    users:
      '<circle cx="8.5" cy="8.2" r="3"/><path d="M2.8 19.5c0-3.2 2.6-5.3 5.7-5.3s5.7 2.1 5.7 5.3"/><circle cx="17" cy="9" r="2.3"/><path d="M15.6 14.6c2.4.4 4 2.2 4 4.9"/>',
    shower:
      '<path d="M7 20V7h7v2.4"/><path d="M5.3 11h1.7"/><circle cx="14" cy="11.6" r="2.5"/><path d="M11.4 15.6v1.3M14 15.8v1.6M16.6 15.6v1.3"/>',
    sparkle:
      '<path d="M12 3v4.4M12 16.6V21M3 12h4.4M16.6 12H21M5.8 5.8l3.1 3.1M15.1 15.1l3.1 3.1M18.2 5.8l-3.1 3.1M8.9 15.1l-3.1 3.1"/>',
    gift: '<path d="M3.6 16.4h16.8"/><path d="M6.2 16.4a5.8 5.8 0 0 1 11.6 0"/><path d="M12 8.3V6.6"/><circle cx="12" cy="5.7" r="0.95"/>',
    clock: '<circle cx="12" cy="12" r="8.3"/><path d="M12 7.6V12l2.8 1.9"/>',
    'arrow-right': '<path d="M4 12h16"/><path d="M13 5.5 20.5 12 13 18.5"/>',
  };
  const roomIcon = (name, size = 18) =>
    `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ROOM_ICONS[name]}</svg>`;

  function renderRooms() {
    const list = $('#room-list');
    const selectedBox = $('#room-selected');

    // Con una habitación ya elegida, se oculta la lista entera y solo queda
    // el resumen + "cambiar fecha / continuar": así no hay 10 tarjetas
    // alrededor de esos botones dando confusión sobre qué se ha elegido.
    const chosen = state.rooms.find((r) => r.slug === state.roomSlug);
    // En escritorio/tablets grandes el resumen solo aporta algo una vez hay
    // habitación elegida (antes, mientras se mira la cuadrícula, cada
    // tarjeta ya enseña su propio precio y estado): esta clase es lo que
    // controla esa visibilidad ahí (ver el media query en el <style>).
    document.querySelector('.book-grid')?.classList.toggle('room-nopick', !chosen);
    if (chosen) {
      list.hidden = true;
      selectedBox.hidden = false;
      selectedBox.innerHTML = `
        <p class="room-selected-label">${fmt('book.room.number', { n: chosen.roomNumber })}</p>
        <button type="button" class="btn btn-ghost" id="room-change">${T['book.room.change']}</button>`;
      $('#room-change').addEventListener('click', () => {
        state.roomSlug = '';
        renderRooms();
        renderSummary();
        $('#room-next').disabled = true;
      });
      $('#room-next').disabled = false;
      return;
    }
    list.hidden = false;
    selectedBox.hidden = true;
    selectedBox.innerHTML = '';

    list.innerHTML = '';
    let anyUsable = false;
    for (const room of state.rooms) {
      const fits = room.capacity >= state.guests;
      const usable = room.available && fits;
      const selected = state.roomSlug === room.slug;
      anyUsable = anyUsable || usable;

      const card = document.createElement('article');
      card.className = `room-card${usable ? '' : ' is-disabled'}${selected ? ' is-selected' : ''}`;

      const media =
        room.photos && room.photos.length > 0
          ? `<img class="room-card-img" src="${room.photos[0]}" alt="${fmt('roomcard.title', { n: room.roomNumber })}" loading="lazy" />`
          : `<div class="room-card-placeholder"><span>${fmt('roomcard.title', { n: room.roomNumber })}</span><small>${T['roomcard.photopending']}</small></div>`;
      const nav =
        room.photos && room.photos.length > 1
          ? `<button type="button" class="room-card-nav prev" data-dir="-1" aria-label="Anterior">${roomIcon('arrow-right')}</button>
             <button type="button" class="room-card-nav next" data-dir="1" aria-label="Siguiente">${roomIcon('arrow-right')}</button>
             <div class="room-card-dots">${room.photos.map((_, i) => `<span class="${i === 0 ? 'is-active' : ''}" data-dot="${i}"></span>`).join('')}</div>`
          : '';

      let status = '';
      if (!room.available) status = `<span class="tag tag-off">${T['book.room.unavailable']}</span>`;
      else if (!fits) status = `<span class="tag tag-off">${fmt('book.room.toosmall', { n: state.guests })}</span>`;

      card.innerHTML = `
        <div class="room-card-media" data-photos='${JSON.stringify(room.photos || [])}' data-idx="0">${media}${nav}</div>
        <div class="room-card-body">
          <h3>${fmt('book.room.number', { n: room.roomNumber })}</h3>
          <ul class="room-card-facts">
            <li>${roomIcon('pin')}${room.floor}</li>
            <li>${roomIcon('users')}${fmt('book.room.capacity', { n: room.capacity })}</li>
            <li>${roomIcon('shower')}${T['roomcard.bath']}</li>
            <li>${roomIcon('sparkle')}${T['roomcard.balcony']}</li>
            <li>${roomIcon('gift')}${T['roomcard.snack']}</li>
            <li>${roomIcon('clock')}${fmt('roomcard.hours', { start: cfg.accessStart, end: cfg.accessEnd })}</li>
          </ul>
          <p class="room-card-note room-card-private">${T['roomcard.private']}</p>
          <div class="room-card-footer">
            <p class="room-card-price"><strong>${fmt('book.room.price', { price: money(room.price / state.guests) })}</strong></p>
            ${
              usable
                ? `<button type="button" class="btn btn-gold room-select" aria-pressed="${selected}">${selected ? T['book.room.selected'] : T['book.room.select']}${roomIcon('arrow-right', 16)}</button>`
                : status
            }
          </div>
        </div>`;

      if (usable) {
        card.querySelector('.room-select').addEventListener('click', () => {
          const wasSelected = state.roomSlug === room.slug;
          state.roomSlug = wasSelected ? '' : room.slug;
          renderRooms();
          renderSummary();
          $('#room-next').disabled = !state.roomSlug;
          // Al elegir habitación, se lleva la vista a "Cambiar fecha / Continuar"
          // para no obligar a bajar a mano por toda la lista de habitaciones.
          if (!wasSelected) $('#room-next').scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      }
      list.appendChild(card);
    }
    if (!anyUsable) {
      const p = document.createElement('p');
      p.className = 'hint';
      p.textContent = T['book.room.none'];
      list.appendChild(p);
    }
    $('#room-next').disabled = !state.roomSlug;
  }

  $('#room-next').addEventListener('click', () => show('details'));

  document.querySelectorAll('[data-nav]').forEach((b) =>
    b.addEventListener('click', () => show(b.dataset.nav)),
  );

  // El carrusel de fotos de .room-card (clic y swipe) NO se reimplementa
  // aquí: RoomCard.astro ya registra esa delegación en `document`, y su
  // script se carga en todas las páginas (se comprobó que iba x2 cuando
  // esta página tenía su propia copia — cada clic/swipe avanzaba 2 fotos
  // en vez de 1, una por cada delegación activa).

  // ---- Paso datos -----------------------------------------------------
  const form = $('#details-form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setErr('details', '');
    form.querySelectorAll('.invalid').forEach((el) => el.classList.remove('invalid'));

    const fd = new FormData(form);
    const payload = {
      date: state.date,
      roomSlug: state.roomSlug,
      guests: state.guests,
      firstName: (fd.get('firstName') || '').trim(),
      lastName: (fd.get('lastName') || '').trim(),
      email: (fd.get('email') || '').trim(),
      phone: (fd.get('phone') || '').trim(),
      country: (fd.get('country') || '').trim(),
      notes: (fd.get('notes') || '').trim(),
      confirmVia: fd.get('confirmVia') || 'email',
      consent: fd.get('consent') === 'on',
      lang: cfg.locale,
    };

    const bad = [];
    if (!payload.firstName) bad.push('firstName');
    if (!payload.lastName) bad.push('lastName');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(payload.email)) bad.push('email');
    if (payload.phone.replace(/\D/g, '').length < 6) bad.push('phone');
    if (bad.length) {
      markInvalid(bad);
      return setErr('details', T['book.details.err.fields']);
    }
    if (!payload.consent) return setErr('details', T['book.details.err.consent']);

    const btn = $('#details-submit');
    loading(btn, true, T['book.details.sending']);
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (data.ok && data.mode === 'redirect') {
        window.location.href = data.url;
        return;
      }
      if (data.ok) {
        state.locator = data.locator;
        state.persisted = data.persisted;
        state.paid = data.paid;
        state.quote = data.quote;
        state.email = payload.email;
        state.phone = payload.phone;
        state.confirmVia = payload.confirmVia;
        renderDone();
        renderSummary();
        show('done');
        return;
      }
      if (data.error === 'datos') {
        markInvalid(data.fields || []);
        setErr('details', T['book.details.err.fields']);
      } else if (data.error === 'sin-disponibilidad') {
        setErr('details', T['book.err.availability']);
      } else if (data.error === 'servicio') {
        setErr('details', T['book.err.service']);
      } else {
        setErr('details', T['book.err.generic']);
      }
    } catch {
      setErr('details', T['book.err.service']);
    } finally {
      loading(btn, false);
    }
  });

  function markInvalid(names) {
    for (const n of names) {
      const el = form.querySelector(`[name="${n}"]`);
      if (el) el.classList.add('invalid');
    }
  }

  function renderDone() {
    $('#done-locator').textContent = state.locator;
    $('#done-title').textContent = T['book.done.title'];
    $('#done-body').textContent = fmt(state.confirmVia === 'phone' ? 'book.done.body.phone' : 'book.done.body.email', {
      email: state.email,
      phone: state.phone,
    });
    $('#done-demo').hidden = state.persisted;
    $('#done-demo-payment').hidden = state.paid;

    const room = state.rooms.find((r) => r.slug === state.roomSlug) || null;
    const rows = [row(T['book.summary.date'], fdate(state.date)), row(T['book.summary.guests'], String(state.guests))];
    if (room) rows.push(row(T['book.summary.room'], fmt('book.room.number', { n: room.roomNumber })));
    let html = rows.join('');
    if (state.quote) html += `<div class="sum-total"><span>${T['book.summary.total']}</span><strong>${money(state.quote.total)}</strong></div>`;
    $('#done-summary').innerHTML = html;
  }

  // ---- Resumen -------------------------------------------------------
  function renderSummary() {
    const body = $('#summary-body');
    if (!state.date) {
      body.innerHTML = `<p class="hint">${T['book.summary.empty']}</p>`;
      return;
    }
    const room = state.rooms.find((r) => r.slug === state.roomSlug) || null;
    const rows = [row(T['book.summary.date'], fdate(state.date)), row(T['book.summary.guests'], String(state.guests))];
    if (room)
      rows.push(row(T['book.summary.room'], fmt('book.room.number', { n: room.roomNumber }), T['book.summary.snack']));
    let html = rows.join('');
    if (room)
      html += `<div class="sum-total"><span>${T['book.summary.total']}</span><strong>${money(room.price)}</strong></div>`;
    body.innerHTML = html;
  }
  function row(label, value, aside) {
    return `<div class="sum-row"><span>${label}</span><span>${value}</span>${aside ? `<em>${aside}</em>` : ''}</div>`;
  }

  // ---- Vuelta de Stripe Checkout (?paid=1&session_id=…) ---------------
  if (params.get('canceled')) {
    setErr('date', T['book.err.canceled']);
  }

  if (params.get('paid') && params.get('session_id')) {
    show('done');
    $('#done-title').textContent = '';
    $('#done-body').textContent = '';
    loadPaidBooking(params.get('session_id'));
  } else {
    // ---- Prefill desde la URL (?room=&date=&guests=) ----------------
    // La preselección de "room" (si sigue disponible) la hace runAvailability.
    if (params.get('date')) {
      dateEl.value = params.get('date');
      state.date = dateEl.value;
      renderCalendar();
    }
    if (params.get('guests')) guestsEl.value = params.get('guests');
    if (dateEl.value) runAvailability();
  }

  async function loadPaidBooking(sessionId) {
    try {
      const res = await fetch(`/api/checkout-status?session_id=${encodeURIComponent(sessionId)}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'error');
      state.date = data.date;
      state.guests = data.guests;
      state.roomSlug = data.room.slug;
      state.rooms = [{ ...data.room, available: true, price: data.quote.total }];
      state.locator = data.locator;
      state.persisted = data.persisted;
      state.paid = true;
      state.quote = data.quote;
      state.email = data.email;
      state.phone = data.phone;
      state.confirmVia = data.confirmVia;
      renderDone();
      renderSummary();
      history.replaceState(null, '', location.pathname);
    } catch {
      setErr('details', T['book.err.service']);
      show('date');
    }
  }
  }
</script>

<style is:global>
  .book { max-width: 1200px; }
  .book .book-steps {
    display: flex; flex-wrap: wrap; gap: 8px 4px; list-style: none;
    padding: 0; margin: 0 0 40px;
  }
  .book .book-steps li {
    display: flex; align-items: center; gap: 8px; flex: 1; min-width: 120px;
    font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
    color: var(--text-soft);
  }
  .book .book-steps .n {
    width: 26px; height: 26px; border-radius: 50%; flex: none;
    display: grid; place-items: center;
    border: 2px solid var(--cream-dark); font-family: var(--ff-body);
  }
  .book .book-steps li.is-active { color: var(--navy); }
  .book .book-steps li.is-active .n { border-color: var(--gold); color: var(--navy); }
  .book .book-steps li.is-done .n { background: var(--gold); border-color: var(--gold); color: #fff; }

  .book .book-grid { display: grid; grid-template-columns: 1fr 300px; gap: 40px; }
  @media (max-width: 820px) { .book .book-grid { grid-template-columns: 1fr; } }
  /* Paso Fecha: sin resumen que mostrar todavía, así que tampoco se le
     reserva la columna de 300px (quedaría un hueco vacío a la derecha). */
  .book .book-grid.no-summary { grid-template-columns: 1fr; }
  /* Botones del paso Habitación: hijo directo de .book-grid (a propósito,
     ver el comentario en el HTML), no de .book-main, para que caigan
     debajo del resumen en vez de entre la lista de habitaciones y él. En
     escritorio ocupan las dos columnas para no quedar solo bajo la 1ª. */
  .book .book-grid > .actions { grid-column: 1 / -1; }

  /* El nav es fixed y tapa la parte de arriba: sin este margen, al cambiar
     de paso scrollIntoView (block:'start') deja el título justo debajo,
     oculto detrás del nav en vez de asomar por debajo. */
  .book .panel { scroll-margin-top: 96px; }
  .book .panel h2 { font-size: 24px; margin-bottom: 6px; outline: none; }
  .book .hint { color: var(--text-soft); font-size: 14px; }
  .book .panel > .hint { margin-bottom: 20px; }

  .book .fields { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (max-width: 520px) { .book .fields { grid-template-columns: 1fr; } }

  .book .cal-label { display: block; font-size: 13px; font-weight: 600; color: var(--text-mid); margin-bottom: 8px; }
  .book .calendar { max-width: 360px; margin-bottom: 10px; }
  .book .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
  .book .cal-dow { text-align: center; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-soft); padding-bottom: 4px; }
  .book .cal-day {
    aspect-ratio: 1; border-radius: var(--r); border: 1px solid var(--cream-dark);
    background: #fff; font: inherit; font-size: 14px; color: var(--text);
    display: grid; place-items: center; transition: border-color .2s, background .2s;
  }
  .book .cal-day.is-empty { visibility: hidden; }
  .book .cal-day:not(:disabled):hover { border-color: var(--gold); }
  .book .cal-day.is-free { border-color: var(--gold-light); }
  .book .cal-day.is-pending { color: var(--text-soft); }
  .book .cal-day.is-full { color: var(--text-soft); text-decoration: line-through; opacity: .5; cursor: not-allowed; }
  .book .cal-day.is-selected { background: var(--gold); border-color: var(--gold); color: #fff; }
  /* En móvil muy estrecho la última columna (domingo) queda tapada por los
     FABs de Llamar/WhatsApp; se acorta el calendario para que no se solape. */
  @media (max-width: 480px) {
    .book .calendar { padding-right: 56px; }
  }
  .book .cal-legend { display: flex; gap: 16px; font-size: 12px; color: var(--text-soft); margin: 10px 0 20px; }
  .book .cal-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .book .cal-legend .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .book .dot-free { background: var(--gold-light); }
  .book .dot-full { background: var(--cream-dark); }
  .book label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; color: var(--text-mid); }
  .book label.full { margin-top: 16px; }
  .book input, .book textarea, .book select {
    font: inherit; padding: 11px 12px; border: 1px solid var(--cream-dark);
    border-radius: var(--r); background: #fff; color: var(--text);
  }
  .book input:focus, .book textarea:focus, .book select:focus { outline: 2px solid var(--gold); outline-offset: 1px; border-color: var(--gold); }
  .book input.invalid { border-color: #c0392b; background: #fdf3f2; }

  .book label.check { flex-direction: row; align-items: flex-start; gap: 10px; margin-top: 18px; font-weight: 400; color: var(--text-mid); }
  .book label.check input { margin-top: 3px; }
  .book label.check a { color: var(--gold); text-decoration: underline; }

  .book .confirm-via { border: 0; padding: 0; margin: 18px 0 0; }
  .book .confirm-via legend { font-size: 13px; font-weight: 600; color: var(--text-mid); padding: 0 0 8px; }
  .book .confirm-via .radio {
    flex-direction: row; align-items: center; gap: 8px; font-weight: 400;
    color: var(--text-mid); display: inline-flex; margin-right: 20px;
  }

  .book .cards { display: grid; gap: 28px; }
  .book .room-card { cursor: default; }
  .book .room-select[disabled] { opacity: .6; cursor: not-allowed; }

  /* En tablets grandes y escritorio, mismo diseño que en Home: varias
     tarjetas por fila (foto arriba, texto centrado) en vez de una columna
     de tarjetas anchas. El resumen se oculta solo mientras se mira la
     cuadrícula sin elegir aún (ahí ya se ve el precio/estado de cada
     tarjeta y solo quitaba sitio); en cuanto se elige habitación, vuelve a
     aparecer, ahora a ancho completo justo encima de "Cambiar datos". */
  @media (min-width: 821px) {
    .book .book-grid.room-nopick .book-summary { display: none; }
    .book .book-grid,
    .book .book-grid.no-summary { grid-template-columns: 1fr; }

    .book .cards { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .book #room-list .room-card { grid-template-columns: 1fr; }
    .book #room-list .room-card-media { order: 1; aspect-ratio: 4 / 3; height: auto; }
    .book #room-list .room-card-body { order: 2; text-align: center; }
    .book #room-list .room-card-body h3 { text-align: center; }
    .book #room-list .room-card-facts {
      grid-template-columns: 1fr; max-width: 280px; margin-left: auto; margin-right: auto;
    }
    .book #room-list .room-card-footer,
    .book #room-list .room-card-price { justify-content: center; }
  }

  /* Con habitación ya elegida se oculta la lista entera (#room-list) y solo
     queda esta línea + los botones "cambiar fecha / continuar", para que no
     haya 10 tarjetas alrededor generando confusión sobre qué se ha elegido. */
  .book .room-selected {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 16px 0; border-bottom: 1px solid var(--cream-dark); margin-bottom: 4px;
  }
  .book .room-selected-label { font-family: var(--ff-display); font-size: 18px; color: var(--navy); }
  .book .room-selected .btn { padding: 8px 16px; font-size: 12px; }

  .book .tag {
    display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; padding: 3px 7px; border-radius: 3px; margin-top: 10px;
  }
  .book .tag-off { color: #c0392b; background: #fdf3f2; }

  .book .err { color: #c0392b; font-size: 13px; font-weight: 600; margin: 14px 0 0; }
  .book .err:empty { display: none; }

  .book .actions { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .book .actions .btn { padding: 13px 24px; }
  .book [data-step="done"] .actions { justify-content: center; }
  .book [data-step="done"] .err { text-align: center; }

  .book .done-card {
    background: var(--navy); color: #fff; border-radius: var(--r-lg);
    padding: 44px 32px; text-align: center; margin-bottom: 20px;
  }
  .book .done-check { width: 60px; height: 60px; margin: 0 auto 20px; }
  .book .done-check circle { fill: none; stroke: var(--gold); stroke-width: 2; }
  .book .done-check path { fill: none; stroke: var(--gold); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .book .done-card h2 { color: #fff; font-size: 26px; margin-bottom: 10px; }
  .book .done-lead { color: rgba(255,255,255,.75); font-size: 15px; line-height: 1.6; max-width: 420px; margin: 0 auto 28px; }
  .book .done-locator {
    display: inline-flex; flex-direction: column; gap: 4px; padding: 14px 32px;
    border: 1px solid rgba(232,201,106,.35); border-radius: var(--r); margin-bottom: 28px;
  }
  .book .done-locator span { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.55); }
  .book .done-locator strong { font-family: var(--ff-display); font-size: 30px; color: var(--gold-light); letter-spacing: .05em; }
  .book .done-summary { max-width: 300px; margin: 0 auto; text-align: left; }
  .book .done-summary .sum-row { border-bottom-color: rgba(255,255,255,.15); }
  .book .done-summary .sum-row span:first-child { color: rgba(255,255,255,.55); }
  .book .done-summary .sum-row span:nth-child(2) { color: #fff; }
  .book .done-summary .sum-total strong { color: var(--gold-light); }

  /* .book-summary (el <aside>, celda de la rejilla) se deja sin estilo
     visual y a la altura completa de su fila (stretch, por defecto): así
     .book-summary-inner tiene sitio de sobra para quedarse pegada (sticky)
     mientras se hace scroll por la lista larga de habitaciones, en vez de
     desaparecer nada más bajar un poco. Si el sticky fuera directo sobre
     .book-summary, al estirarse para tener ese margen se vería como una
     tarjeta gigante con hueco vacío debajo. */
  .book .book-summary-inner {
    background: var(--cream); border-radius: var(--r-lg); padding: 24px;
    position: sticky; top: 96px;
  }
  .book .book-summary h2 { font-size: 16px; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 16px; }
  .book .sum-row { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; padding: 10px 0; border-bottom: 1px solid var(--cream-dark); font-size: 13px; }
  .book .sum-row span:first-child { font-weight: 700; color: var(--text-mid); }
  .book .sum-row span:nth-child(2) { text-align: right; color: var(--text); }
  .book .sum-row em { grid-column: 1 / -1; text-align: right; font-style: normal; font-size: 12px; color: var(--text-soft); }
  .book .sum-total { display: flex; justify-content: space-between; align-items: baseline; padding-top: 14px; margin-top: 4px; }
  .book .sum-total strong { font-family: var(--ff-display); font-size: 20px; color: var(--navy); }
  .book .book-summary .pending { font-size: 12px; color: var(--text-soft); margin-top: 16px; }
  /* En móvil muy estrecho el resumen (valores alineados a la derecha) puede
     quedar tapado por los FABs de Llamar/WhatsApp; y no interesa que quede
     pegado (sticky) al hacer scroll una vez ya está apilado a ancho completo. */
  @media (max-width: 480px) {
    .book .book-summary-inner { padding-right: 76px; }
  }
  @media (max-width: 820px) {
    .book .book-summary-inner { position: static; }
  }
</style>
