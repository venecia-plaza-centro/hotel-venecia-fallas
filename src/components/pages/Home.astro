---
import { type Locale } from '../../consts';
import { pagePath } from '../../i18n/pages';
import { useT } from '../../i18n/ui';
import PageHero from '../PageHero.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

const why = [
  { t: t('home.why.location.t'), d: t('home.why.location.d') },
  { t: t('home.why.whole.t'), d: t('home.why.whole.d') },
  { t: t('home.why.groups.t'), d: t('home.why.groups.d') },
];
---

<PageHero eyebrow={t('home.eyebrow')} title={t('home.h1')} lead={t('home.lead')} />

<section class="section" style="text-align:center">
  <div class="container">
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a class="btn btn-gold" href={pagePath('rooms', lang)}>{t('home.cta.rooms')}</a>
      <a class="btn btn-ghost" href={pagePath('groups', lang)}>{t('home.cta.groups')}</a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2 class="h2" style="text-align:center">{t('home.section.why')}</h2>
    <div class="gold-rule" style="margin:20px auto 48px"></div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px">
      {why.map((w) => (
        <div style="background:#fff;border-radius:var(--r-lg);padding:28px;box-shadow:var(--sh-sm)">
          <h3 style="font-size:19px;margin-bottom:10px">{w.t}</h3>
          <p style="color:var(--text-mid);font-size:14px">{w.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 800px) {
    section.section-alt div[style*='grid-template-columns'] { grid-template-columns: 1fr !important; }
  }
</style>
