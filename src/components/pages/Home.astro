---
import { FALLAS, type Locale } from '../../consts';
import { pagePath } from '../../i18n/pages';
import { useT } from '../../i18n/ui';
import { getRooms } from '../../lib/airtable';
import Icon from '../Icon.astro';
import RoomCard from '../RoomCard.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

const rooms = (await getRooms()).slice(0, 3);
const roomsUrl = pagePath('rooms', lang);

// Cuando haya vídeo real del balcón/mascletá: subirlo a public/video/ y
// poner aquí la ruta (ej. '/video/hero-mascleta.mp4'). Mientras esté vacío
// se ve el degradado de fondo de .hero-photo, como ahora.
const HERO_VIDEO = '';

// Iconos propios (public/icons/*.png, recortados de la lámina dorada del cliente).
const features = [
  { icon: 'binoculars', t: t('home.feature1.t'), d: t('home.feature1.d') },
  { icon: 'armchair', t: t('home.feature2.t'), d: t('home.feature2.d') },
  { icon: 'shower', t: t('home.feature3.t'), d: t('home.feature3.d') },
  { icon: 'tray', t: t('home.feature4.t'), d: t('home.feature4.d') },
];

const strip = [
  { icon: 'clock', t: t('home.strip.schedule.t'), v: t('home.strip.schedule.v') },
  { icon: 'sparkle', t: t('home.strip.mascleta.t'), v: t('home.strip.mascleta.v') },
  { icon: 'key', t: t('home.strip.private.t'), v: t('home.strip.private.v') },
  { icon: 'tray-strip', t: t('home.strip.snack.t'), v: t('home.strip.snack.v') },
];
---

<section class="hero">
  <div class="hero-panel">
    <span class="eyebrow">{t('home.eyebrow')}</span>
    <h1>{t('home.h1.pre')} <em>{t('home.h1.accent')}</em></h1>
    <p class="hero-kicker">{t('home.kicker')}</p>
    <p>{t('home.p1')}</p>
    <p>{t('home.p2')}</p>
    <p class="hero-strong">{t('home.p3')}</p>
    <a class="btn btn-gold" href={roomsUrl}>
      {t('home.cta')}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
  <div class="hero-media">
    <div class="hero-photo" role="img" aria-label={t('home.photo.hero.alt')}>
      {HERO_VIDEO && (
        <video class="hero-video" autoplay muted loop playsinline aria-hidden="true">
          <source src={HERO_VIDEO} type="video/mp4" />
        </video>
      )}
    </div>
    <span class="hero-badge">{t('home.badge')}</span>
    <span class="hero-tagline">{t('home.tagline')}</span>
  </div>
</section>

<section class="section section-alt features">
  <div class="container">
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature">
          <img class="feature-icon" src={`/icons/${f.icon}.png`} width="240" height="240" alt="" loading="lazy" />
          <h3>{f.t}</h3>
          <p>{f.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section tradicion">
  <div class="container tradicion-grid">
    <div class="tradicion-text">
      <span class="eyebrow">{t('home.tradicion.eyebrow')}</span>
      <h2>{t('home.tradicion.h2.pre')} <em>{t('home.tradicion.h2.accent')}</em></h2>
      <p>{t('home.tradicion.p1')}</p>
      <p class="tradicion-strong">{t('home.tradicion.p2')}</p>
    </div>
    <div class="tradicion-media">
      <div class="tradicion-photo">
        <span>{t('home.tradicion.photo.alt')}</span>
      </div>
      <span class="tradicion-tagline">{t('home.tradicion.tagline')}</span>
    </div>
  </div>
</section>

<section class="section section-alt room-picker">
  <div class="container">
    <div class="room-picker-head">
      <span class="eyebrow">{t('home.rooms.eyebrow')}</span>
      <h2 class="h2">{t('home.rooms.h2')}</h2>
      <p class="lead">{t('rooms.intro')}</p>
      <p class="lead">{t('home.rooms.lead')}</p>
    </div>
    <div class="room-picker-list">
      {rooms.map((r) => <RoomCard room={r} lang={lang} perPerson />)}
    </div>
    <div class="room-picker-more">
      <a class="btn btn-ghost" href={roomsUrl}>{t('home.rooms.seeall')}</a>
    </div>
  </div>
</section>

<section class="strip">
  <div class="container strip-grid">
    {strip.map((s) => (
      <div class="strip-item">
        <img class="strip-icon" src={`/icons/${s.icon}.png`} width="240" height="240" alt="" loading="lazy" />
        <div>
          <p class="strip-t">{s.t}</p>
          <p class="strip-v">{s.v}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* ── hero ── */
  .hero { display: grid; grid-template-columns: 5fr 7fr; min-height: 560px; }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; min-height: 0; } }

  .hero-panel {
    background: var(--navy); color: rgba(255,255,255,.9);
    padding: 148px 56px 56px; display: flex; flex-direction: column; gap: 16px;
  }
  .hero-panel .eyebrow { margin-bottom: 4px; }
  .hero-panel h1 {
    color: #fff; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.15; margin-bottom: 4px;
  }
  .hero-panel h1 em { font-style: italic; color: var(--gold-light); }
  .hero-panel p { font-size: 14.5px; line-height: 1.7; color: rgba(255,255,255,.72); }
  /* Selector más específico que ".hero-panel p" (línea de arriba) a propósito:
     con la misma especificidad, la regla general la pisaría siempre. */
  .hero-panel p.hero-kicker {
    font-family: var(--ff-display); font-size: 20px; font-weight: 600;
    line-height: 1.4; color: #fff;
  }
  .hero-strong { color: #fff !important; font-weight: 600; }
  .hero-panel .btn { align-self: flex-start; margin-top: 10px; display: inline-flex; align-items: center; gap: 10px; }
  /* Este bloque va DESPUÉS de las reglas base de arriba: con la misma
     especificidad, si fuera antes el flex-start de línea 134 lo pisaría. */
  @media (max-width: 860px) {
    .hero-panel { padding: 128px 28px 40px; align-items: center; text-align: center; }
    .hero-panel .btn { align-self: center; }
  }

  .hero-media { position: relative; background: var(--navy-light); }
  .hero-photo {
    position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 28px;
    color: rgba(255,255,255,.5); font-size: 13px;
    background:
      radial-gradient(circle at 75% 20%, rgba(201,162,70,.28), transparent 45%),
      radial-gradient(circle at 20% 80%, rgba(201,162,70,.16), transparent 50%),
      linear-gradient(200deg, var(--navy-light), var(--navy) 80%);
  }
  /* Vídeo de fondo opcional (ver HERO_VIDEO arriba): cubre el degradado de
     .hero-photo sin tapar el sello ni la frase manuscrita, que van encima. */
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-badge {
    position: absolute; top: 108px; right: 34px; width: 112px; height: 112px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 16px; transform: rotate(-11deg);
    color: var(--gold-light); font-size: 10.5px; font-weight: 700;
    letter-spacing: .05em; text-transform: uppercase;
    border: 1.5px solid var(--gold-light);
    background: radial-gradient(circle at 32% 28%, rgba(232,201,106,.22), rgba(201,162,70,.03) 70%);
    box-shadow: 0 10px 24px rgba(0,0,0,.32), inset 0 0 0 1px rgba(232,201,106,.2);
  }
  .hero-badge::before {
    content: ''; position: absolute; inset: 8px; border-radius: 50%;
    border: 1px solid rgba(232,201,106,.5);
  }
  .hero-badge::after {
    content: ''; position: absolute; inset: -6px; border-radius: 50%;
    border: 1px dashed rgba(232,201,106,.25);
  }
  .hero-tagline {
    position: absolute; left: 28px; bottom: 24px; font-family: 'Caveat', cursive;
    font-size: 30px; color: var(--gold-light); transform: rotate(-3deg);
  }
  @media (max-width: 860px) { .hero-media { min-height: 320px; } }

  /* ── features ── */
  .features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; text-align: center; }
  @media (max-width: 760px) { .features-grid { grid-template-columns: 1fr 1fr; } }
  .feature { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .feature-icon { width: 52px; height: 52px; object-fit: contain; }
  .feature h3 { font-size: 15px; }
  .feature p { font-size: 13px; color: var(--text-mid); }

  /* ── tradición ── */
  .tradicion-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  @media (max-width: 860px) {
    .tradicion-grid { grid-template-columns: 1fr; text-align: center; }
  }
  .tradicion-text h2 { margin: 12px 0 18px; font-size: clamp(26px, 3.4vw, 36px); }
  .tradicion-text h2 em { font-style: italic; color: var(--gold); }
  .tradicion-text p { color: var(--text-mid); font-size: 15px; line-height: 1.7; margin-bottom: 12px; }
  .tradicion-strong { color: var(--navy) !important; font-weight: 600; }

  .tradicion-media { position: relative; }
  .tradicion-photo {
    aspect-ratio: 4/3; border-radius: var(--r-lg); overflow: hidden; display: flex;
    align-items: flex-end; padding: 20px; color: rgba(255,255,255,.6); font-size: 12px;
    background:
      radial-gradient(circle at 30% 30%, rgba(201,162,70,.3), transparent 50%),
      linear-gradient(160deg, var(--navy-light), var(--navy));
  }
  .tradicion-tagline {
    position: absolute; right: 18px; bottom: -14px; font-family: 'Caveat', cursive;
    font-size: 26px; color: var(--gold); background: #fff; padding: 4px 14px;
    border-radius: 999px; box-shadow: var(--sh-sm); transform: rotate(2deg);
  }

  /* ── room picker ── */
  .room-picker-head { max-width: 640px; margin: 0 auto 44px; text-align: center; }
  .room-picker-head .eyebrow { display: block; margin-bottom: 10px; }
  .room-picker-head .lead { margin-top: 14px; }
  .room-picker-list { display: grid; gap: 28px; max-width: 980px; margin: 0 auto; }
  .room-picker-more { text-align: center; margin-top: 36px; }

  /* ── franja inferior ── */
  .strip { background: var(--navy); padding: 32px 0; }
  .strip-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .strip-item { display: flex; align-items: center; gap: 12px; color: #fff; }
  .strip-icon { width: 46px; height: 46px; object-fit: contain; flex-shrink: 0; }
  .strip-t { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.6); }
  .strip-v { font-size: 14px; font-weight: 600; }
  /* Estas dos reglas van DESPUÉS de las bases de arriba: con la misma
     especificidad, si fueran antes las de arriba las pisarían siempre. */
  @media (max-width: 860px) {
    .strip-grid { justify-items: center; }
    .strip-item { flex-direction: column; text-align: center; gap: 8px; }
  }
  @media (max-width: 760px) { .strip-grid { grid-template-columns: 1fr 1fr; } }

  /* En móvil muy estrecho, los párrafos en negrita (texto centrado a
     ancho casi completo) pueden quedar tapados por los FABs de Llamar
     y WhatsApp; se acortan un poco las líneas con este padding lateral. */
  @media (max-width: 480px) {
    .hero-strong, .tradicion-strong { padding: 0 60px; }
  }
</style>
