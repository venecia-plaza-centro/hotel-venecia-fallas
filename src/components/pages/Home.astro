---
import { FALLAS, type Locale } from '../../consts';
import { pagePath } from '../../i18n/pages';
import { useT } from '../../i18n/ui';
import { getRooms } from '../../lib/airtable';
import GoldRule from '../GoldRule.astro';
import Icon from '../Icon.astro';
import RoomCard from '../RoomCard.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);

const rooms = (await getRooms()).slice(0, 3);
const roomsUrl = pagePath('rooms', lang);

// Las 3 frases del kicker del hero, una debajo de otra en vez de en párrafo.
const kickerHtml = t('home.kicker').replace(/\.\s+/g, '.<br />');

// Vídeo real de una mascletà (marca de agua "FPM" quitada por difuminado
// de esa esquina). Si se quita el archivo o se vacía esta ruta, vuelve a
// verse el degradado de fondo de .hero-photo.
const HERO_VIDEO = '/video/hero-mascleta.mp4';

// Iconos propios (public/icons/*.png, recortados de la lámina dorada del cliente).
const features = [
  { icon: 'binoculars', t: t('home.feature1.t'), d: t('home.feature1.d') },
  { icon: 'llave', t: t('home.feature2.t'), d: t('home.feature2.d') },
  { icon: 'bano-privado', t: t('home.feature3.t'), d: t('home.feature3.d') },
  { icon: 'tray', t: t('home.feature4.t'), d: t('home.feature4.d') },
];

// (sección "strip" eliminada: se sustituyó por la de "features", movida
// abajo del todo, en su lugar)
---

<section class="hero">
  <div class="hero-panel">
    <h1>{t('home.h1.pre')} <em>{t('home.h1.accent')}</em></h1>
    <GoldRule style="margin:0 0 4px" />
    <p class="hero-kicker" set:html={kickerHtml} />
    <a class="btn btn-gold" href={roomsUrl}>
      {t('home.cta')}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
  <div class="hero-media">
    <div class="hero-photo" role="img" aria-label={t('home.photo.hero.alt')}>
      {HERO_VIDEO && (
        <video class="hero-video" autoplay muted loop playsinline aria-hidden="true">
          <source src={HERO_VIDEO} type="video/mp4" />
        </video>
      )}
    </div>
    <span class="hero-badge">{t('home.badge')}</span>
    <span class="hero-tagline">{t('home.tagline')}</span>
  </div>
</section>

<section class="section tradicion">
  <div class="container tradicion-grid">
    <div class="tradicion-text">
      <span class="eyebrow">{t('home.tradicion.eyebrow')}</span>
      <h2>{t('home.tradicion.h2.pre')} <em>{t('home.tradicion.h2.accent')}</em></h2>
      <p>{t('home.tradicion.p1')}</p>
      <p class="tradicion-strong">{t('home.tradicion.p2')}</p>
    </div>
    <div class="tradicion-media">
      <img class="tradicion-photo" src="/images/home/tradicion-mascleta.webp" alt={t('home.tradicion.photo.alt')} loading="lazy" />
      <span class="tradicion-tagline">{t('home.tradicion.tagline')}</span>
    </div>
  </div>
</section>

<section class="section section-alt room-picker">
  <div class="container">
    <div class="room-picker-head">
      <span class="eyebrow">{t('home.rooms.eyebrow')}</span>
      <h2 class="h2">{t('home.rooms.h2')}</h2>
      <p class="lead">{t('rooms.intro')}</p>
      <p class="lead">{t('home.rooms.lead')}</p>
    </div>
    <div class="room-picker-list" id="rooms">
      {rooms.map((r) => <RoomCard room={r} lang={lang} />)}
    </div>
    <div class="room-picker-more">
      <a class="btn btn-ghost" href={roomsUrl}>{t('home.rooms.seeall')}</a>
    </div>
  </div>
</section>

<section class="section section-alt features">
  <div class="container">
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature">
          <img class="feature-icon" src={`/icons/${f.icon}.png`} width="240" height="240" alt="" loading="lazy" />
          <h3>{f.t}</h3>
          <p>{f.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── hero ── */
  /* Sin min-height a propósito: la fila del grid (y con ella el vídeo,
     misma altura que su columna hermana) se ajusta al contenido real del
     panel de texto, para que no sobre alto por debajo del botón dorado. */
  .hero { display: grid; grid-template-columns: 1fr 1fr; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    /* La foto va arriba del todo en móvil/tablet, antes que el texto. */
    .hero-media { order: 1; }
    .hero-panel { order: 2; }
  }

  .hero-panel {
    background: var(--navy); color: rgba(255,255,255,.9);
    /* El nav es fixed y se superpone (~92px) sobre el propio padding
       superior del panel: sin compensarlo, el hueco visible arriba (una
       vez tapado por el nav) queda mucho más corto que el de abajo, que sí
       se ve entero. Se suma esa altura al padding-top para que ambos
       huecos, ya visibles, midan lo mismo. */
    padding: calc(92px + 40px) 56px 40px; display: flex; flex-direction: column;
    justify-content: center; align-items: center; text-align: center; gap: 16px;
  }
  .hero-panel .eyebrow { margin-bottom: 4px; }
  .hero-panel h1 {
    color: #fff; font-size: clamp(34px, 3.6vw, 44px); line-height: 1.15; margin-bottom: 4px;
  }
  .hero-panel h1 em { font-style: italic; color: var(--gold-light); }
  .hero-panel p { font-size: 14.5px; line-height: 1.7; color: rgba(255,255,255,.72); }
  /* Selector más específico que ".hero-panel p" (línea de arriba) a propósito:
     con la misma especificidad, la regla general la pisaría siempre. */
  .hero-panel p.hero-kicker {
    font-family: var(--ff-display); font-size: 20px; font-weight: 600;
    line-height: 1.4; color: #fff;
  }
  .hero-strong { color: #fff !important; font-weight: 600; }
  .hero-panel .btn { align-self: center; margin-top: 10px; display: inline-flex; align-items: center; gap: 10px; }
  @media (max-width: 860px) {
    .hero-panel { padding: 56px 28px; }
  }

  .hero-media { position: relative; background: var(--navy-light); }
  .hero-photo {
    position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 28px;
    color: rgba(255,255,255,.5); font-size: 13px;
    background:
      radial-gradient(circle at 75% 20%, rgba(201,162,70,.28), transparent 45%),
      radial-gradient(circle at 20% 80%, rgba(201,162,70,.16), transparent 50%),
      linear-gradient(200deg, var(--navy-light), var(--navy) 80%);
  }
  /* Vídeo de fondo opcional (ver HERO_VIDEO arriba): cubre el degradado de
     .hero-photo sin tapar el sello ni la frase manuscrita, que van encima. */
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-badge {
    /* Esquina inferior derecha a propósito: ahí es donde estaba la marca
       de agua del vídeo (ya difuminada), así el sello la tapa del todo. */
    position: absolute; bottom: 24px; right: 24px; width: 172px; height: 172px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 20px; transform: rotate(11deg);
    color: var(--gold-light); font-size: 13px; font-weight: 700;
    letter-spacing: .05em; text-transform: uppercase;
    border: 1.5px solid var(--gold-light);
    background: radial-gradient(circle at 32% 28%, rgba(46, 61, 97, .97), rgba(27,42,74,.97) 70%);
    box-shadow: 0 10px 24px rgba(0,0,0,.45), inset 0 0 0 1px rgba(232,201,106,.2);
  }
  .hero-badge::before {
    content: ''; position: absolute; inset: 8px; border-radius: 50%;
    border: 1px solid rgba(232,201,106,.5);
  }
  /* Puntitas doradas muy pequeñas alrededor, como en un sello/medalla real:
     un SVG con el anillo de puntas ya recortado (el hueco central es parte
     del propio dibujo, no un mask-image — así se ve igual en cualquier
     navegador) de fondo, apenas asomando por fuera del círculo. */
  .hero-badge::after {
    content: ''; position: absolute; inset: -1%;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20100%20100'%3E%3Cpath%20d='M50.00,0.00L53.81,1.65L57.82,0.62L61.32,2.84L65.45,2.45L68.56,5.19L72.70,5.45L75.34,8.65L79.39,9.55L81.50,13.12L85.36,14.64L86.88,18.50L90.45,20.61L91.35,24.66L94.55,27.30L94.81,31.44L97.55,34.55L97.16,38.68L99.38,42.18L98.35,46.19L100.00,50.00L98.35,53.81L99.38,57.82L97.16,61.32L97.55,65.45L94.81,68.56L94.55,72.70L91.35,75.34L90.45,79.39L86.88,81.50L85.36,85.36L81.50,86.88L79.39,90.45L75.34,91.35L72.70,94.55L68.56,94.81L65.45,97.55L61.32,97.16L57.82,99.38L53.81,98.35L50.00,100.00L46.19,98.35L42.18,99.38L38.68,97.16L34.55,97.55L31.44,94.81L27.30,94.55L24.66,91.35L20.61,90.45L18.50,86.88L14.64,85.36L13.12,81.50L9.55,79.39L8.65,75.34L5.45,72.70L5.19,68.56L2.45,65.45L2.84,61.32L0.62,57.82L1.65,53.81L0.00,50.00L1.65,46.19L0.62,42.18L2.84,38.68L2.45,34.55L5.19,31.44L5.45,27.30L8.65,24.66L9.55,20.61L13.12,18.50L14.64,14.64L18.50,13.12L20.61,9.55L24.66,8.65L27.30,5.45L31.44,5.19L34.55,2.45L38.68,2.84L42.18,0.62L46.19,1.65ZM98.2,50.0a48.2,48.2%200%201,0%20-96.4,0a48.2,48.2%200%201,0%2096.4,0Z'%20fill='%23E8C96A'%20fill-rule='evenodd'/%3E%3C/svg%3E");
    background-size: 100% 100%; background-repeat: no-repeat;
    opacity: .85;
  }
  .hero-tagline {
    position: absolute; left: 28px; bottom: 24px; font-family: 'Caveat', cursive;
    font-size: 30px; color: var(--gold-light); transform: rotate(-3deg);
  }
  @media (max-width: 860px) {
    .hero-media { min-height: 320px; }
    /* A caballo entre el vídeo y el panel de texto de debajo (apilados en
       móvil/tablet): mitad sobre el vídeo, mitad sobre el fondo azul. Más
       pequeño y pegado a la derecha para no tapar "Fallas, más cerca que
       nunca". */
    .hero-badge {
      width: 92px; height: 92px; padding: 10px; font-size: 8.5px;
      bottom: -46px; right: 16px; z-index: 1;
    }
  }

  /* ── features ── */
  /* Menos aire arriba/abajo que un .section normal, en todos los tamaños.
     Fondo blanco a propósito (no el crema de .section-alt, que comparte
     con .room-picker): aquí se quiere distinto. */
  .features { padding: 32px 0; background: #fff; }
  .features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; text-align: center; }
  @media (max-width: 760px) { .features-grid { grid-template-columns: 1fr 1fr; } }
  .feature { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .feature-icon { width: 52px; height: 52px; object-fit: contain; }
  .feature h3 { font-size: 15px; }
  .feature p { font-size: 13px; color: var(--text-mid); }

  /* ── tradición ── */
  .tradicion-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; text-align: center; }
  @media (max-width: 860px) {
    .tradicion-grid { grid-template-columns: 1fr; }
  }
  .tradicion-text h2 { margin: 12px 0 18px; font-size: clamp(26px, 3.4vw, 36px); }
  .tradicion-text h2 em { font-style: italic; color: var(--gold); }
  .tradicion-text p { color: var(--text-mid); font-size: 15px; line-height: 1.7; margin-bottom: 12px; }
  .tradicion-strong { color: var(--navy) !important; font-weight: 600; }

  .tradicion-media { position: relative; }
  .tradicion-photo {
    aspect-ratio: 4/3; width: 100%; display: block; border-radius: var(--r-lg);
    object-fit: cover;
  }
  .tradicion-tagline {
    position: absolute; right: 18px; bottom: -14px; font-family: 'Caveat', cursive;
    font-size: 26px; color: var(--gold-light); background: var(--navy); padding: 4px 14px;
    border-radius: 999px; box-shadow: var(--sh-sm); transform: rotate(2deg);
  }

  /* ── room picker ── */
  .room-picker-head { max-width: 640px; margin: 0 auto 44px; text-align: center; }
  .room-picker-head .eyebrow { display: block; margin-bottom: 10px; }
  .room-picker-head .lead { margin-top: 14px; }
  /* scroll-margin-top: el botón Reservar del header enlaza aquí (#rooms);
     sin esto, el ancla quedaría tapada por el nav fijo. */
  .room-picker-list {
    display: grid; grid-template-columns: 1fr;
    gap: 28px; margin: 0 auto; scroll-margin-top: 96px;
  }
  /* 3 columnas a partir de aquí (tablets y escritorio); en móvil, apiladas
     en 1 columna, si no las tarjetas quedan demasiado estrechas. */
  @media (min-width: 600px) {
    .room-picker-list { grid-template-columns: repeat(3, 1fr); }
  }
  .room-picker-more { text-align: center; margin-top: 36px; }

  /* En móvil muy estrecho, los párrafos en negrita (texto centrado a
     ancho casi completo) pueden quedar tapados por los FABs de Llamar
     y WhatsApp; se acortan un poco las líneas con este padding lateral. */
  @media (max-width: 480px) {
    .hero-strong, .tradicion-strong { padding: 0 60px; }
  }
</style>
