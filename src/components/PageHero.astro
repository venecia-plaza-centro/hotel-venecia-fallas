---
import GoldRule from './GoldRule.astro';

interface Props { title: string; lead?: string; leadItalic?: boolean; leadStrong?: boolean; photo?: string; }
const { title, lead, leadItalic = false, leadStrong = false, photo } = Astro.props;

// "balcón"/"balcony" en cursiva y dorado dentro del título, igual que el
// acento del h1 de Home (dos de estos títulos la incluyen: Habitaciones y
// Reservar).
const titleHtml = title.replace(/\b(balcón|balcony)\b/i, '<em>$1</em>');

// "Plaza del Ayuntamiento" enlaza a Google Maps (con destino ya puesto, para
// que el móvil calcule la ruta desde la ubicación GPS del usuario) en los
// leads que la mencionan (Habitaciones, Mascletás).
const MAPS_URL = 'https://www.google.com/maps/dir/?api=1&destination=Plaza+del+Ayuntamiento,+Valencia';
const leadHtml = lead?.replace(
  /Plaza del Ayuntamiento/i,
  `<a href="${MAPS_URL}" target="_blank" rel="noopener">$&</a>`,
);
---

<section class={`page-hero${photo ? ' has-photo' : ''}`}>
  {photo && <img class="page-hero-photo" src={photo} alt="" aria-hidden="true" />}
  <div class="container">
    <h1 set:html={titleHtml} />
    <GoldRule />
    {leadHtml && (
      <p class={`lead${leadItalic ? ' lead-italic' : ''}${leadStrong ? ' lead-strong' : ''}`} set:html={leadHtml} />
    )}
    <slot />
  </div>
</section>
