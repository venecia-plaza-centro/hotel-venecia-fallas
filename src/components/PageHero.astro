---
import GoldRule from './GoldRule.astro';

interface Props { title: string; lead?: string; leadItalic?: boolean; leadStrong?: boolean; photo?: string; accent?: string; shine?: boolean; tall?: boolean; scrollLabel?: string; scrollHref?: string; rule?: boolean; bottom?: boolean; }
const { title, lead, leadItalic = false, leadStrong = false, photo, accent, shine = false, tall = false, scrollLabel, scrollHref = '#contenido', rule = true, bottom = false } = Astro.props;

// "balcón"/"balcony"/"balcone"/"Balkon" en cursiva y dorado dentro del título,
// igual que el acento del h1 de Home (lo llevan Balcones y Reservar). Con `accent`
// se marca esa parte exacta del título (p. ej. "Espacios privados"). `shine` (y
// siempre con `accent`) añade el destello dorado de la portada.
const BALCONY = /\b(balcón|balcony|balcone|balcon|Balkon)\b/i;
const emTag = accent || shine ? '<em class="shine">' : '<em>';
const titleHtml =
  accent && title.includes(accent)
    ? title.replace(accent, `${emTag}${accent}</em>`)
    : title.replace(BALCONY, `${emTag}$1</em>`);

// "Plaza del Ayuntamiento" enlaza a Google Maps (con destino ya puesto, para
// que el móvil calcule la ruta desde la ubicación GPS del usuario) en los
// leads que la mencionan (Habitaciones, Mascletàs).
const MAPS_URL = 'https://www.google.com/maps/dir/?api=1&destination=Plaza+del+Ayuntamiento,+Valencia';
// {br} en un lead = salto de línea en todos los tamaños de pantalla.
const leadHtml = lead?.replace(/\{br\}/g, '<br class="lead-br">').replace(
  /Plaza del Ayuntamiento/i,
  `<a href="${MAPS_URL}" target="_blank" rel="noopener">$&</a>`,
);
---

<section class={`page-hero${photo ? ' has-photo' : ''}${photo && tall ? ' is-tall' : ''}${scrollLabel ? ' has-scroll' : ''}${rule ? '' : ' no-rule'}${bottom ? ' is-bottom' : ''}`}>
  {photo && <img class="page-hero-photo" src={photo} alt="" aria-hidden="true" />}
  <div class="container">
    <h1 set:html={titleHtml} />
    {rule && <GoldRule />}
    {leadHtml && (
      <p class={`lead${leadItalic ? ' lead-italic' : ''}${leadStrong ? ' lead-strong' : ''}`} set:html={leadHtml} />
    )}
    <slot />
  </div>
  {scrollLabel && (
    <a class="page-hero-scroll" href={scrollHref}>
      <span>{scrollLabel}</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </a>
  )}
</section>
