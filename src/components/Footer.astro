---
import { SITE, FALLAS, type Locale } from '../consts';
import { pagePath } from '../i18n/pages';
import { useT } from '../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-info">
        <div class="footer-brand">
          <img src="/img/logo-hotel-venecia.png" alt="" width="64" height="64" />
          <strong style="font-family:var(--ff-display);font-size:17px;color:#fff;display:block">
            {t('brand.name')} <span style="color:var(--gold)">{t('brand.sub')}</span>
          </strong>
        </div>
        <p style="font-family:var(--ff-display);font-style:italic;color:var(--gold);font-size:18px">{t('footer.tagline')}</p>
        <p style="margin-top:10px">{SITE.address}</p>
        <p><a href={SITE.phoneHref}>{SITE.phone}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div class="footer-links">
        <a href={SITE.mainSite}>{t('footer.mainsite')}</a>
        <a href={pagePath('mascletas', lang)}>{t('nav.mascletas')}</a>
        <a href={pagePath('faq', lang)}>{t('nav.faq')}</a>
      </div>
    </div>
    <div class="footer-legal">
      <span>© {year} {SITE.name} · Fallas {FALLAS.year}. {t('footer.rights')}</span>
      <a href={pagePath('terms', lang)}>{t('footer.terms')}</a>
      <a href={pagePath('cancellation', lang)}>{t('footer.cancellation')}</a>
      <a href={pagePath('privacy', lang)}>{t('footer.privacy')}</a>
    </div>
  </div>
</footer>
