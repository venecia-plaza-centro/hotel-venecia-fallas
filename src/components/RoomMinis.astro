---
import { FALLAS, type Locale } from '../consts';
import { pagePath } from '../i18n/pages';
import { useT } from '../i18n/ui';
import { GUEST_OPTIONS, type Room } from '../lib/booking';
import Icon from './Icon.astro';

interface Props { rooms: Room[]; lang: Locale; }
const { rooms, lang } = Astro.props;
const t = useT(lang);
const fmt = (key: string, vars: Record<string, string | number> = {}) =>
  t(key).replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

// "9 balcones privados, cada uno en una habitación…": lo de antes de la primera
// coma es el titular (con el número destacado) y el resto, la aclaración.
const [countHeadFull, ...countRest] = fmt('home.minis.count', { n: rooms.length }).split(/,\s*/);
const countHead = countHeadFull.replace(/^\d+\s*/, '');
const countTail = countRest.join(', ');
const bookUrl = pagePath('book', lang);
const maxCapacity = Math.max(...rooms.map((r) => r.capacity));
const money = (n: number) =>
  new Intl.NumberFormat(lang === 'en' ? 'en-GB' : 'es-ES', {
    style: 'currency', currency: 'EUR', maximumFractionDigits: 0,
  }).format(n);
// Mismo "Desde X € / persona" que las fichas grandes (ver RoomCard.astro).
const minPerPerson = (room: Room) => Math.min(
  ...GUEST_OPTIONS.map((g) => room.prices.weekday[g] / g),
  ...GUEST_OPTIONS.map((g) => room.prices.weekend[g] / g),
);
---

<div class="room-minis">
  <div class="room-incl">
    <p class="room-incl-h">{t('home.minis.incl')}</p>
    <ul class="room-incl-list">
      <li><Icon name="shower" size={20} /><span>{t('home.minis.bath')}</span></li>
      <li><Icon name="users" size={20} /><span>{fmt('roomcard.capacity', { n: maxCapacity })}</span></li>
      <li><Icon name="clock" size={20} /><span>{fmt('roomcard.hours', { start: FALLAS.accessStart, end: FALLAS.accessEnd })}</span></li>
      <li><Icon name="gift" size={20} /><span>{t('roomcard.snack')}</span></li>
    </ul>
    <p class="room-incl-note">{t('roomcard.private')}</p>
  </div>
  <p class="room-minis-count">
    <span class="room-minis-head"><span class="room-minis-num">{rooms.length}</span> {countHead}</span>
    {countTail && <span class="room-minis-tail">{countTail}</span>}
  </p>
  <ul class="room-minis-grid">
    {rooms.map((r) => (
      <li>
        <a class="room-mini" href={`${bookUrl}?room=${r.slug}`} data-room-slug={r.slug} aria-label={fmt('roomcard.title', { n: r.roomNumber })}>
          {r.photos[0]
            ? <img src={r.photos[0]} alt="" width="320" height="320" loading="lazy" decoding="async" />
            : <span class="room-mini-ph" aria-hidden="true"></span>}
          <span class="room-mini-badge">{t('roomcard.soldout.badge')}</span>
          <span class="room-mini-info">
            <span class="room-mini-floor">{r.floor}</span>
            <span class="room-mini-n">{r.roomNumber}</span>
            <span class="room-mini-price">{t('roomcard.from')} {money(minPerPerson(r))}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  // Mismo mecanismo que las fichas grandes (RoomCard.astro): Home es una
  // página estática, así que las fotos firmadas de Airtable se refrescan y
  // las habitaciones agotadas se marcan en el navegador.
  const minis = document.querySelectorAll<HTMLAnchorElement>('.room-mini[data-room-slug]');
  if (minis.length) {
    const hasRemote = [...minis].some((m) => /^https?:/.test(m.querySelector('img')?.getAttribute('src') || ''));
    if (hasRemote) {
      fetch('/api/room-photos')
        .then((r) => r.json())
        .then((data) => {
          if (!data.ok) return;
          const photos = data.photos as Record<string, string[]>;
          minis.forEach((m) => {
            const fresh = photos[m.dataset.roomSlug || ''];
            const img = m.querySelector('img');
            if (img && fresh && fresh[0]) img.src = fresh[0];
          });
        })
        .catch(() => {});
    }
    fetch('/api/rooms-availability')
      .then((r) => r.json())
      .then((data) => {
        if (!data.ok) return;
        for (const slug of data.soldOut as string[]) {
          document.querySelector(`.room-mini[data-room-slug="${slug}"]`)?.classList.add('is-soldout');
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .room-minis { max-width: 540px; margin: 0 auto 44px; scroll-margin-top: 96px; }
  .room-incl { background: #fff; border: 1px solid var(--cream-dark); border-radius: 16px; padding: 22px 20px 18px; margin-bottom: 32px; box-shadow: var(--sh-sm); }
  .room-incl-h { text-wrap: balance; text-align: center; font-family: var(--ff-display); font-size: 20px; color: var(--navy); margin: 0 0 16px; }
  .room-incl-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; }
  .room-incl-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.45; color: var(--text-mid); text-align: left; }
  .room-incl-list li :global(svg) { flex: none; margin-top: 1px; color: var(--gold); }
  .room-incl-wide { grid-column: 1 / -1; }
  .room-incl-note { margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--cream-dark); text-align: center; font-size: 13.5px; font-weight: 600; color: var(--navy); line-height: 1.5; }
  @media (max-width: 480px) {
    .room-incl { padding: 18px 16px 16px; }
    .room-incl-list { grid-template-columns: 1fr; }
  }
  .room-minis-count { text-align: center; margin: 0 0 20px; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .room-minis-head { font-family: var(--ff-display); font-weight: 700; font-size: clamp(24px, 5.4vw, 32px); line-height: 1.1; color: var(--navy); }
  .room-minis-num { font-style: italic; font-size: 1.45em; color: var(--gold); line-height: 1; margin-right: 2px; }
  .room-minis-tail { font-size: 15px; color: var(--text-mid); }
  .room-minis-tail::before, .room-minis-tail::after { content: ''; display: inline-block; width: 28px; height: 1px; background: var(--gold); vertical-align: middle; margin: 0 12px; opacity: .8; }
  @media (max-width: 480px) { .room-minis-tail::before, .room-minis-tail::after { display: none; } }
  .room-minis-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  @media (max-width: 480px) { .room-minis-grid { gap: 8px; } }
  .room-mini {
    position: relative; display: block; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 12px;
    background: var(--navy); container-type: inline-size; box-shadow: var(--sh-sm);
    transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  }
  @media (hover: hover) { .room-mini:hover { transform: translateY(-4px); box-shadow: var(--sh-md); } }
  .room-mini img, .room-mini-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .room-mini-ph { background: linear-gradient(135deg, var(--navy), #2c4170); }
  /* Degradado azul abajo para que número y precio se lean sobre cualquier foto. */
  .room-mini::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(20, 31, 56, 0) 28%, rgba(20, 31, 56, .94) 100%);
  }
  .room-mini-info {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 0 4px 8px;
    display: flex; flex-direction: column; align-items: center; text-align: center; line-height: 1.1;
  }
  .room-mini-floor { font-size: clamp(8px, 6cqw, 10px); letter-spacing: .06em; text-transform: uppercase; color: var(--gold-light); font-weight: 600; text-shadow: 0 1px 6px rgba(8, 14, 30, .8); }
  .room-mini-n { font-family: var(--ff-display); font-weight: 700; color: #fff; font-size: clamp(18px, 20cqw, 28px); margin: 2px 0; text-shadow: 0 1px 8px rgba(8, 14, 30, .6); }
  .room-mini-price { font-size: clamp(9px, 7cqw, 12px); color: rgba(255, 255, 255, .92); text-shadow: 0 1px 6px rgba(8, 14, 30, .8); }
  .room-mini-badge {
    display: none; position: absolute; top: 6px; left: 50%; transform: translateX(-50%); z-index: 2;
    background: #fff; color: var(--navy); font-size: clamp(8px, 6.5cqw, 11px); font-weight: 700;
    padding: 3px 8px; border-radius: 999px; white-space: nowrap;
  }
  .room-mini.is-soldout img, .room-mini.is-soldout .room-mini-ph { filter: grayscale(1); opacity: .6; }
  .room-mini.is-soldout .room-mini-badge { display: block; }
</style>
