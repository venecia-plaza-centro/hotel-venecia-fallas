---
import { LOCALES, LOCALE_NAMES, type Locale } from '../consts';
import { PAGES, pagePath, type PageId } from '../i18n/pages';
import { useT } from '../i18n/ui';
import InfoModal from './InfoModal.astro';

interface Props { lang: Locale; pageId: PageId; }
const { lang, pageId } = Astro.props;
const t = useT(lang);

const navItems = PAGES.filter((p) => p.inNav);
const isHome = pageId === 'home';
// "Preguntas frecuentes" se apila en dos líneas solo cuando el menú lleva también
// "Espacios" (con las dos cosas, la cápsula se queda justa). Mientras la página de
// Espacios esté oculta (inNav: false en i18n/pages.ts) el menú queda como siempre.
const stackFaq = navItems.some((p) => p.id === 'spaces');
// En la propia página de reserva no tiene sentido un botón "Reservar" que
// lleve... a la página en la que ya está el cliente. Cabecera minimalista:
// solo marca centrada y el hamburger.
const isBook = pageId === 'book';
// La página de Balcones usa la cabecera de Home ya "scrolleada" desde el
// principio: marca a la izquierda y botón Reservar siempre visible.
const isRooms = pageId === 'rooms';
// "Reservar" (cabecera y menú móvil) lleva a la página de reserva de balcones, salvo en la
// página de Espacios: ahí baja a la lista de espacios, donde cada uno tiene su propio
// botón «Reservar este espacio» (el alquiler de un espacio se reserva por espacio).
// En la portada, que ofrece balcones y espacios, «Reservar» lleva a la página de Balcones.
const bookHref = pageId === 'spaces' ? '#espacios-vistazo' : pageId === 'home' ? pagePath('rooms', lang) : pagePath('book', lang);
---

<nav class={`nav${isHome || isRooms ? ' nav-home' : ''}${isBook ? ' nav-minimal' : ''}${isRooms ? ' is-scrolled' : ''}`} data-always-scrolled={isRooms ? 'true' : undefined}>
  <div class="nav-inner">
    <a class="nav-brand" href={pagePath('home', lang)} aria-label={t('brand.name')}>
      <img src="/img/logo-hotel-venecia.png" alt="" width="58" height="58" />
      <span class="nav-brand-text">
        <strong>Hotel <span class="nav-brand-gold">Venecia</span></strong>
        <span class="nav-brand-sub">{t('brand.sub')}</span>
        <span class="nav-brand-fallas">Fallas 2027</span>
      </span>
    </a>

    <div class="nav-links">
      {navItems.map((item) => {
        // "Preguntas frecuentes" (y sus equivalentes) en dos líneas, una palabra
        // bajo la otra: con "Espacios" en el menú, la cápsula se desbordaba en
        // pantallas de 1120–1200 px.
        const words = t(`nav.${item.id}`).split(' ');
        const stacked = stackFaq && item.id === 'faq' && words.length === 2;
        return (
          <a class={stacked ? 'nav-stacked' : undefined} href={pagePath(item.id, lang)}>
            {stacked ? <>{words[0]}<br />{words[1]}</> : t(`nav.${item.id}`)}
          </a>
        );
      })}
    </div>

    <div class="nav-right">
      <div class="lang-dd" id="lang-dd">
        <button type="button" class="lang-dd-btn" aria-haspopup="true" aria-expanded="false" aria-label={t('nav.menu')}>
          {lang.toUpperCase()}
          <svg class="lang-dd-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="lang-dd-menu" role="menu">
          {LOCALES.map((l) => (
            <a class={`lang-dd-item${l === lang ? ' is-active' : ''}`} href={pagePath(pageId, l)} hreflang={l} lang={l} role="menuitem">
              {LOCALE_NAMES[l]}
            </a>
          ))}
        </div>
      </div>
      {!isBook && <a class="btn btn-gold" href={bookHref} data-info-open="reservar-choice">{t('nav.book')}</a>}
      <button type="button" class="hamburger" id="hamburger" aria-expanded="false" aria-controls="mobile-nav" aria-label={t('nav.menu')}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Menú móvil a pantalla completa, igual que el de hotelvenecia.com -->
<div class="mobile-nav" id="mobile-nav">
  <button type="button" class="mobile-nav-close" id="mobile-nav-close" aria-label={t('nav.close')}>&times;</button>
  <div class="mobile-nav-logo">
    <a href={pagePath('home', lang)} aria-label={t('brand.name')}>
      <img src="/img/logo-hotel-venecia.png" alt="Hotel Venecia Plaza Centro" width="92" height="92" />
    </a>
  </div>
  {navItems.map((item) => (
    <a href={pagePath(item.id, lang)}>{t(`nav.${item.id}`)}</a>
  ))}
  {!isBook && <a href={bookHref} class="mobile-nav-cta" data-info-open="reservar-choice">{t('nav.book')}</a>}
  <div class="mobile-nav-langs">
    {LOCALES.map((l) => (
      <a href={pagePath(pageId, l)} hreflang={l} class={l === lang ? 'is-active' : ''}>
        {l}
      </a>
    ))}
  </div>
</div>

{/* «Reservar» (cabecera y menú móvil) abre esta ventana para elegir entre balcones y espacios; sin JavaScript,
    el botón sigue llevando a `bookHref`. */}
{!isBook && (
  <InfoModal id="reservar-choice" narrow label={t('nav.book')} closeLabel={t('nav.close')}>
    <h2 class="choice-title">{t('nav.choose.title')}</h2>
    <div class="choice-grid">
      <a class="choice" href={pagePath('rooms', lang)}>
        <span class="choice-photo"><img src="/images/rooms/410/balcon.webp" width="640" height="480" alt="" loading="lazy" decoding="async" /></span>
        <strong class="choice-name">{t('nav.rooms')}</strong>
        <span class="choice-btn">{t('home.cta.rooms')}</span>
      </a>
      <a class="choice" href={pagePath('spaces', lang)}>
        <span class="choice-photo"><img src="/images/espacios/704/foto-800.webp" width="800" height="450" alt="" loading="lazy" decoding="async" /></span>
        <strong class="choice-name">{t('nav.spaces')}</strong>
        <span class="choice-btn">{t('home.cta.spaces')}</span>
      </a>
    </div>
  </InfoModal>
)}

<script>
  const langDd = document.getElementById('lang-dd');
  if (langDd) {
    const btn = langDd.querySelector('.lang-dd-btn');
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = langDd.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', () => {
      langDd.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        langDd.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  const hamburger = document.getElementById('hamburger');
  const closeBtn = document.getElementById('mobile-nav-close');
  const overlay = document.getElementById('mobile-nav');
  if (hamburger && closeBtn && overlay) {
    const open = () => {
      overlay.classList.add('open');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      overlay.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    hamburger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    overlay.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  // Cabecera especial de Home: arriba del todo va sobre el hero (fondo
  // azul, marca centrada, sin botón); al bajar pasa al nav normal (blanco,
  // marca a la izquierda, botón Reservar más pequeño a la derecha).
  // En la página de reserva (.nav-minimal) la marca se queda centrada
  // siempre (nunca hay botón ahí), solo cambia el fondo azul→blanco.
  // Todas las páginas marcan el scroll: es lo que activa el header flotante (cápsula).
  const scrollNav = document.querySelector('.nav');
  if (scrollNav) {
    const alwaysScrolled = scrollNav.hasAttribute('data-always-scrolled');
    const onScroll = () => scrollNav.classList.toggle('is-scrolled', alwaysScrolled || window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .choice-title { margin: 0 0 18px; text-align: center; font-family: var(--ff-display); font-size: 26px; line-height: 1.2; color: var(--navy); }
  .choice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .choice { display: flex; flex-direction: column; overflow: hidden; border-radius: 16px; border: 1px solid var(--cream-dark); background: #fff; box-shadow: var(--sh-sm); text-align: center; text-decoration: none; transition: transform .25s, box-shadow .25s, border-color .25s; }
  .choice:hover, .choice:focus-visible { transform: translateY(-3px); box-shadow: var(--sh-md); border-color: var(--gold); }
  .choice-photo { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--navy); }
  .choice-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .choice-name { padding: 14px 12px 0; font-family: var(--ff-display); font-size: 22px; letter-spacing: .06em; text-transform: uppercase; color: var(--navy); }
  .choice-btn { margin: 12px 14px 16px; padding: 10px 14px; border-radius: 999px; background: var(--gold); border: 2px solid var(--gold); color: var(--navy); font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; transition: background .3s, color .3s, border-color .3s; }
  .choice:hover .choice-btn, .choice:focus-visible .choice-btn { background: var(--navy); border-color: var(--navy); color: var(--gold-light); }
  @media (max-width: 520px) {
    .choice-grid { grid-template-columns: 1fr; gap: 12px; }
    .choice-title { font-size: 22px; }
    .choice { display: grid; grid-template-columns: 40% 1fr; grid-template-areas: 'photo name' 'photo btn'; align-items: center; }
    .choice-photo { grid-area: photo; aspect-ratio: auto; height: 100%; min-height: 112px; }
    .choice-name { grid-area: name; padding: 12px 12px 0; font-size: 19px; align-self: end; }
    .choice-btn { grid-area: btn; margin: 10px 12px 14px; padding: 9px 10px; font-size: 11.5px; align-self: start; }
  }
</style>
