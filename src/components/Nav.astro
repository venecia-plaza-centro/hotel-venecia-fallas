---
import { LOCALES, LOCALE_NAMES, type Locale } from '../consts';
import { PAGES, pagePath, type PageId } from '../i18n/pages';
import { useT } from '../i18n/ui';

interface Props { lang: Locale; pageId: PageId; }
const { lang, pageId } = Astro.props;
const t = useT(lang);

const navItems = PAGES.filter((p) => p.inNav);
const isHome = pageId === 'home';
// En la propia página de reserva no tiene sentido un botón "Reservar" que
// lleve... a la página en la que ya está el cliente. Cabecera minimalista:
// solo marca centrada (igual que arriba del todo en Home) y el hamburger.
const isBook = pageId === 'book';
// En Home, "Reservar" del header no salta directo al flujo de pago: baja a
// la lista de habitaciones de la propia Home, para que el cliente empiece
// a elegir desplazándose hacia abajo (cada ficha ya tiene su "Reservar
// habitación X" que sí lleva al flujo real).
const bookHref = isHome ? `${pagePath('home', lang)}#rooms` : pagePath('book', lang);
---

<nav class={`nav${isHome ? ' nav-home' : ''}${isBook ? ' nav-minimal' : ''}`}>
  <div class="nav-inner">
    <a class="nav-brand" href={pagePath('home', lang)} aria-label={t('brand.name')}>
      <img src="/img/logo-hotel-venecia.png" alt="" width="44" height="44" />
      <span class="nav-brand-text">
        <strong>{t('brand.name')}</strong>
        <span>{t('brand.sub')} · Fallas 2027</span>
      </span>
    </a>

    <div class="nav-links">
      {navItems.map((item) => (
        <a href={pagePath(item.id, lang)}>{t(`nav.${item.id}`)}</a>
      ))}
    </div>

    <div class="nav-right">
      <div class="lang-dd" id="lang-dd">
        <button type="button" class="lang-dd-btn" aria-haspopup="true" aria-expanded="false" aria-label={t('nav.menu')}>
          {lang.toUpperCase()}
          <svg class="lang-dd-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="lang-dd-menu" role="menu">
          {LOCALES.map((l) => (
            <a class={`lang-dd-item${l === lang ? ' is-active' : ''}`} href={pagePath(pageId, l)} hreflang={l} lang={l} role="menuitem">
              {LOCALE_NAMES[l]}
            </a>
          ))}
        </div>
      </div>
      {!isBook && <a class="btn btn-gold" href={bookHref}>{t('nav.book')}</a>}
      <button type="button" class="hamburger" id="hamburger" aria-expanded="false" aria-controls="mobile-nav" aria-label={t('nav.menu')}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Menú móvil a pantalla completa, igual que el de hotelvenecia.com -->
<div class="mobile-nav" id="mobile-nav">
  <button type="button" class="mobile-nav-close" id="mobile-nav-close" aria-label={t('nav.close')}>&times;</button>
  <div class="mobile-nav-logo">
    <a href={pagePath('home', lang)} aria-label={t('brand.name')}>
      <img src="/img/logo-hotel-venecia.png" alt="Hotel Venecia Plaza Centro" width="92" height="92" />
    </a>
  </div>
  {navItems.map((item) => (
    <a href={pagePath(item.id, lang)}>{t(`nav.${item.id}`)}</a>
  ))}
  {!isBook && <a href={bookHref} class="mobile-nav-cta">{t('nav.book')}</a>}
  <div class="mobile-nav-langs">
    {LOCALES.map((l) => (
      <a href={pagePath(pageId, l)} hreflang={l} class={l === lang ? 'is-active' : ''}>
        {l}
      </a>
    ))}
  </div>
</div>

<script>
  const langDd = document.getElementById('lang-dd');
  if (langDd) {
    const btn = langDd.querySelector('.lang-dd-btn');
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = langDd.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', () => {
      langDd.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        langDd.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  const hamburger = document.getElementById('hamburger');
  const closeBtn = document.getElementById('mobile-nav-close');
  const overlay = document.getElementById('mobile-nav');
  if (hamburger && closeBtn && overlay) {
    const open = () => {
      overlay.classList.add('open');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      overlay.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    hamburger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    overlay.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  // Cabecera especial de Home: arriba del todo va sobre el hero (fondo
  // azul, marca centrada, sin botón); al bajar pasa al nav normal (blanco,
  // marca a la izquierda, botón Reservar más pequeño a la derecha).
  // En la página de reserva (.nav-minimal) la marca se queda centrada
  // siempre (nunca hay botón ahí), solo cambia el fondo azul→blanco.
  const scrollNav = document.querySelector('.nav.nav-home, .nav.nav-minimal');
  if (scrollNav) {
    const onScroll = () => scrollNav.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
