---
import { FALLAS, type Locale } from '../consts';
import { pagePath } from '../i18n/pages';
import { useT } from '../i18n/ui';
import { GUEST_OPTIONS, type Room } from '../lib/booking';
import Icon from './Icon.astro';

interface Props { room: Room; lang: Locale; }
const { room, lang } = Astro.props;
const t = useT(lang);
const fmt = (key: string, vars: Record<string, string | number> = {}) =>
  t(key).replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

const bookUrl = pagePath('book', lang);
const money = (n: number) =>
  new Intl.NumberFormat(lang === 'en' ? 'en-GB' : 'es-ES', {
    style: 'currency',
    currency: 'EUR',
    maximumFractionDigits: 0,
  }).format(n);

// "Desde X € / persona": el mínimo posible, que se da con 4 personas
// (180 € / 4 = 45 €), ya que el precio total no baja al repartir entre más.
const minPerPerson = Math.min(...GUEST_OPTIONS.map((g) => room.prices[g] / g));
---

<article class="room-card">
  <div class="room-card-media" data-photos={JSON.stringify(room.photos)} data-idx="0">
    {room.photos.length > 0 ? (
      <img class="room-card-img" src={room.photos[0]} alt={fmt('roomcard.title', { n: room.roomNumber })} loading="lazy" />
    ) : (
      <div class="room-card-placeholder">
        <span>{fmt('roomcard.title', { n: room.roomNumber })}</span>
        <small>{t('roomcard.photopending')}</small>
      </div>
    )}
    {room.photos.length > 1 && (
      <>
        <button type="button" class="room-card-nav prev" data-dir="-1" aria-label="Anterior">
          <Icon name="arrow-right" size={18} />
        </button>
        <button type="button" class="room-card-nav next" data-dir="1" aria-label="Siguiente">
          <Icon name="arrow-right" size={18} />
        </button>
        <div class="room-card-dots">
          {room.photos.map((_, i) => <span class={i === 0 ? 'is-active' : ''} data-dot={i}></span>)}
        </div>
      </>
    )}
  </div>

  <div class="room-card-body">
    <h3>{fmt('roomcard.title', { n: room.roomNumber })}</h3>

    <ul class="room-card-facts">
      <li><Icon name="pin" size={18} />{room.floor}</li>
      <li><Icon name="users" size={18} />{fmt('roomcard.capacity', { n: room.capacity })}</li>
      <li><Icon name="shower" size={18} />{t('roomcard.bath')}</li>
      <li><Icon name="sparkle" size={18} />{t('roomcard.balcony')}</li>
      <li><Icon name="gift" size={18} />{t('roomcard.snack')}</li>
      <li><Icon name="clock" size={18} />{fmt('roomcard.hours', { start: FALLAS.accessStart, end: FALLAS.accessEnd })}</li>
    </ul>

    <p class="room-card-note room-card-private">{t('roomcard.private')}</p>

    <div class="room-card-footer">
      <p class="room-card-price">
        <span>{t('roomcard.from')}</span>
        <strong>{money(minPerPerson)}</strong>
        <span>{t('roomcard.perperson')}</span>
      </p>
      <a class="btn btn-gold" href={`${bookUrl}?room=${room.slug}`}>
        {fmt('roomcard.book', { n: room.roomNumber })}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <p class="room-card-note">{t('roomcard.priceNote')}</p>
    <p class="room-card-hint">{t('roomcard.hint')}</p>
  </div>
</article>

<script>
  // Delegación de eventos: sirve para todas las .room-card de la página
  // (Home puede mostrar varias, Habitaciones las nueve).
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest('.room-card-nav') as HTMLButtonElement | null;
    if (!btn) return;
    const media = btn.closest('.room-card-media') as HTMLElement | null;
    if (!media) return;
    const photos: string[] = JSON.parse(media.dataset.photos || '[]');
    if (!photos.length) return;
    let idx = parseInt(media.dataset.idx || '0', 10);
    idx = (idx + Number(btn.dataset.dir) + photos.length) % photos.length;
    media.dataset.idx = String(idx);
    const img = media.querySelector('img');
    if (img) img.src = photos[idx];
    media.querySelectorAll('[data-dot]').forEach((d) => {
      d.classList.toggle('is-active', d.getAttribute('data-dot') === String(idx));
    });
  });
</script>

{/* Estilos de .room-card* en src/styles/global.css: los comparte con el
    paso "Habitación" del flujo de reserva (Book.astro). */}
